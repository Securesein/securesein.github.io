---
// Fundamentals is a reading path, not a feed — see byReadingPath in
// src/posts.ts. Ordering evergreen explainers by date tells a newcomer
// to start in the wrong place.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import { postsOfKind } from "../../posts";

const posts = await postsOfKind("explainer");
---
<BaseLayout
  title="Fundamentals"
  description="Evergreen explainers: one AI concept at a time, explained properly and written to still make sense next year."
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="securesein — Fundamentals"
    href="/fundamentals/rss.xml"
  />

  <div class="container container--wide">
    <PageHeader
      title="Fundamentals"
      standfirst="One idea at a time, explained properly. Nothing here is tied to a particular week's news, and all of it should still be true next year. Read them in order if you're starting from scratch."
    />

    <ol class="path">
      {posts.map((post, i) => (
        <li>
          <PostCard post={post} step={i + 1} />
          {i === 0 && <p class="path-start">Start here.</p>}
        </li>
      ))}
    </ol>

    {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
  </div>
</BaseLayout>

<style>
  .path {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }
  /* Two columns once there is enough to fill them; a single-item path
     rendered half-width just looks broken. */
  @media (min-width: 900px) {
    .path { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.6rem; }
    .path:has(> li:only-child) { grid-template-columns: minmax(0, 34rem); }
  }
  .path-start {
    margin-top: -0.6rem;
    color: var(--signal);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .empty { color: var(--text-muted); padding-block: 2rem; }
</style>
