---
// Rewritten to the same structural language as the homepage
// (hero-topografie-en-about handoff): a topography hero, then a
// two-column reading layout with a sticky colophon/links rail.
//
// Several pieces the source brief itself flags as unwritten are left
// as visible TODOs below rather than invented — the disclosure-scale
// percentages and their descriptions, the launch year, and any
// "Elsewhere" link beyond the repo. One sentence the brief supplied
// outright ("Nothing here is published without me reading it end to
// end...") is left out entirely: it contradicts what this page and
// the colophon already say about News items, which nobody reads
// before they publish.
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { SITE, SECTIONS } from "../consts";
---
<BaseLayout
  title="About"
  description="Who writes this, what the three sections are, and exactly how much of it a model drafted."
  reading={true}
>
  <section class="about-hero">
    <div class="hero-nodes" aria-hidden="true"><canvas></canvas></div>

    <div class="container">
      <Eyebrow label="About" />
      <h1>Why this site exists</h1>
      <p class="lede">
        A technology enthusiast since I was young, now deep in machine
        learning — this site is mostly how I keep up with it myself.
      </p>
    </div>
  </section>

  <div class="container">
    <div class="cols">
      <div class="prose">
        <section class="block">
          <p class="first">
            I'm {SITE.author}. I've been into technology for as long as I can
            remember, and these days that curiosity is pointed squarely at
            machine learning. This site exists mainly for myself: a way to
            actually keep up with a field that moves faster than any one
            person can track by skimming headlines, and to work through the
            mechanism behind something rather than just the announcement of
            it. If it turns out to be useful to anyone else along the way,
            that's a bonus, not the reason it exists.
          </p>
        </section>

        <section class="block">
          <h2>How much of this is written by a model</h2>
          <p>
            Nearly all of the sentences. That is true of the news items, and
            it is also true of the long explainers and the deep dives —
            which an earlier version of this page implied were hand-written,
            and they are not.
          </p>
          <p>
            What differs between them is how much of my judgement went in.
            On the news items: none, in the sense that nobody reads them
            before they publish. On everything else: I choose the subject,
            set the angle, supply the source material, check the claims
            that carry weight, and rewrite what comes back wrong. Every
            post says which of those things actually happened to it, in a
            box directly under the title, generated from a record rather
            than written by hand.
          </p>

          <div class="scale">
            <div class="head">
              <span>My judgement per post type</span>
              <span>model drafts → I direct</span>
            </div>

            <div class="row" data-fill="0">
              <div class="top"><b>News items</b><em>automatic</em></div>
              <div class="track"><i class="fill"></i></div>
              <p>
                Scout drafts and publishes these on its own; nobody reads
                one before it goes out. See "How it's made" below.
              </p>
            </div>
            <!--
              TODO(sebastiaan): the two rows below are structural
              placeholders, not calibrated numbers — I didn't have a real
              source to derive "how directed an explainer is" vs "how
              directed a deep dive is" as distinct percentages (the
              colophon describes the same five-step process for both).
              Replace data-fill and the <p> under each with real figures
              and descriptions, or collapse the two rows into one
              "everything else" row if they're not meaningfully different.
            -->
            <div class="row" data-fill="58">
              <div class="top"><b>Explainers</b><em>directed</em></div>
              <div class="track"><i class="fill"></i></div>
              <p>TODO: real description of what's checked/rewritten here.</p>
            </div>
            <div class="row" data-fill="88">
              <div class="top"><b>Deep dives</b><em>directed</em></div>
              <div class="track"><i class="fill"></i></div>
              <p>TODO: real description of what's checked/rewritten here.</p>
            </div>
          </div>

          <p>
            The long version — which models, what I verify, what I don't,
            and what can still go wrong — is on the
            <a href="/colophon/">colophon</a>.
          </p>
        </section>

        <section class="block">
          <h2>What you'll find here</h2>
          <div class="topics">
            {SECTIONS.map((section) => (
              <a href={section.href}>
                <b>{section.label}</b>
                <span>{section.description}</span>
              </a>
            ))}
          </div>
          <p>
            Cutting across all five are the <a href="/topics/">topics</a> —
            thirteen subjects, so a two-minute news item and a
            twenty-minute teardown on the same thing end up on the same
            shelf. A few of those shelves are nearly empty on purpose:
            they are where this blog is meant to grow.
          </p>
        </section>

        <section class="block">
          <h2>How it's made</h2>
          <p>
            Scout is the pipeline behind the News section. It is not a
            person and it is not a persona; it is a few hundred lines of
            Python on a schedule.
          </p>
          <ol>
            <li>It reads a list of RSS feeds every few hours.</li>
            <li>
              It summarises what is new and messages the summaries to me
              on Telegram.
            </li>
            <li>
              I flag the ones worth writing up — sometimes with a
              one-line steer about the angle, sometimes not.
            </li>
            <li>
              A cloud model drafts a full post from the source article,
              usually within the hour.
            </li>
            <li>
              It publishes. Automatically. <strong>Nobody reads it first —
              not me.</strong> Every one links back to the article it came
              from.
            </li>
          </ol>
          <p>
            What is <em>not</em> reviewed: the facts, the framing, the
            numbers, the conclusion. My only editorial act is choosing
            which item gets written up at all. If a News post here matters
            to you, open its source and check it.
          </p>
          <p>
            Both the site and the pipeline behind it — Scout, the scoring,
            the budget limits, all of it — are open source under MIT.
            Read exactly what a post goes through before it publishes, or
            fork it and point it at your own interests:
            <a href={SITE.github}>the code is on GitHub</a>.
          </p>
        </section>

        <section class="block">
          <h2>Corrections</h2>
          <p>
            If something here is wrong, I would rather know. How
            corrections are handled is on the
            <a href="/colophon/">colophon</a>.
          </p>
          <!-- TODO(sebastiaan): a real closing line above the RSS link,
               and a real contact route if there is one beyond opening a
               correction via the colophon. -->
          <p class="closing">
            <a href="/rss.xml">Subscribe by RSS</a> to everything, or
            <a href="/colophon/">read the colophon</a> for how to flag a
            correction.
          </p>
        </section>
      </div>

      <aside class="rail">
        <div class="rail-block">
          <h2>Colophon</h2>
          <dl>
            <div><dt>Since</dt><dd><!-- TODO: launch year, not just "current year" -->{new Date().getFullYear()}</dd></div>
            <div><dt>Built with</dt><dd>Astro</dd></div>
            <div><dt>Hosted on</dt><dd>GitHub Pages</dd></div>
          </dl>
        </div>
        <div class="rail-block">
          <h2>Elsewhere</h2>
          <ul>
            <li><a href={SITE.github}>GitHub</a></li>
            <!-- TODO(sebastiaan): any other links — Twitter/X, LinkedIn,
                 Mastodon, email — go here. Nothing invented. -->
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- hero: drifting constellation, left-aligned variant.
     Replaces the topography that used to sit here (about-constellatie
     handoff). Note this is the DECORATIVE constellation — random
     points, no meaning. The one on /topics/ draws real data and is a
     separate component on purpose: the two have different jobs and
     sharing the drawing code would force both to compromise. */
  .about-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 6rem 4.5rem;
    /* Same panel as the homepage hero (light-mode-paneel §3), and
       inert in dark where --hero-surface is none. The divider stays
       on --rule rather than --hero-edge: this hero has always had a
       visible one in dark, and --hero-edge is transparent there,
       which would have quietly removed it. */
    background: var(--hero-surface);
    border-bottom: 1px solid var(--rule);
  }
  .hero-nodes {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Without this the layer would swallow taps meant for the links
       underneath — a classic regression, so it is also asserted in the
       checks rather than just written down here. */
    pointer-events: none;
  }
  .hero-nodes canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* About is left-aligned, so the pattern's weight sits left of
       centre and the title keeps a clear field. */
    -webkit-mask-image: radial-gradient(ellipse 78% 72% at 38% 44%, #000 22%, transparent 80%);
            mask-image: radial-gradient(ellipse 78% 72% at 38% 44%, #000 22%, transparent 80%);
  }
  @media print {
    .about-hero { background: none; border-bottom: 0; }
    .hero-nodes { display: none; }
  }
  @media (max-width: 700px) {
    .about-hero { padding-block: 3.5rem 3rem; }
    /* Wider, flatter, and the solid core starts at 14% instead of 22%:
       on a short hero a round mask otherwise crops most of the pattern
       away and leaves a smudge in the middle. */
    .hero-nodes canvas {
      -webkit-mask-image: radial-gradient(ellipse 96% 64% at 50% 40%, #000 14%, transparent 76%);
              mask-image: radial-gradient(ellipse 96% 64% at 50% 40%, #000 14%, transparent 76%);
    }
  }
  .about-hero h1 {
    margin-top: 1.75rem;
    max-width: 20ch;
    font-family: "Archivo", var(--font-sans);
    font-weight: 700;
    font-size: clamp(2.5rem, 5.2vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .about-hero .lede {
    margin-top: 1.1rem;
    max-width: 46ch;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- two-column layout: reading column + sticky rail ----- */
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 4.5rem;
    padding: 4.5rem 0 2.5rem;
  }
  @media (max-width: 980px) {
    .cols { grid-template-columns: 1fr; gap: 3rem; }
  }

  .prose { max-width: 66ch; }
  .prose p {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.72;
    margin: 0 0 1.35em;
    color: var(--text);
  }
  .prose h2 { font-size: 1.4rem; margin-bottom: 0.9rem; }
  .prose ol, .prose ul { font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.65; padding-left: 1.3em; margin: 0 0 1.35em; }
  .prose li { margin-bottom: 0.5em; }
  .prose a { color: var(--link); }

  .block {
    padding-top: 3.5rem;
    margin-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }
  .block:first-of-type { padding-top: 0; margin-top: 0; border-top: 0; }

  /* Drop cap on the intro paragraph only. */
  .prose p.first::first-letter {
    float: left;
    font-size: 4.1em;
    line-height: 0.84;
    padding: 0.06em 0.1em 0 0;
    font-weight: 500;
    color: var(--amber-text);
  }

  .closing { font-family: var(--font-sans); font-size: 0.95rem; }

  /* ---------- disclosure scale ------------------------------------ */
  .scale {
    margin: 2rem 0 2.3rem;
    padding: 1.6rem 1.6rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
  }
  .scale .head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 1.4rem;
  }
  .row { margin-bottom: 1.5rem; }
  .row .top { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.55rem; }
  .row b { font-family: var(--font-sans); font-size: 0.97rem; font-weight: 600; }
  .row em { margin-left: auto; font-style: normal; font-family: var(--font-sans); font-size: 0.78rem; color: var(--text-muted); }
  .row p { font-family: var(--font-serif); font-size: 0.97rem; line-height: 1.6; color: var(--text-muted); margin: 0.7rem 0 0; }

  .track { height: 5px; border-radius: 99px; background: var(--track); overflow: hidden; }
  .fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--violet), var(--amber));
    transition: width 1.1s cubic-bezier(.2,.7,.2,1);
  }
  @media (prefers-reduced-motion: reduce) {
    .fill { transition: none; }
  }

  /* ---------- topics list (rows, not cards — those already live on
     the homepage) -------------------------------------------------- */
  .topics { display: grid; margin: 1.4rem 0; }
  .topics a {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }
  .topics a:last-child { border-bottom: 1px solid var(--rule); }
  .topics a:hover b { color: var(--amber-text); }
  .topics b { font-weight: 700; }
  .topics span { color: var(--text-muted); font-size: 0.95rem; }
  @media (max-width: 620px) {
    .topics a { grid-template-columns: 1fr; gap: 0.25rem; }
  }

  /* ---------- rail -------------------------------------------------- */
  .rail {
    position: sticky;
    top: 6rem;
    align-self: start;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .rail-block + .rail-block { margin-top: 2.2rem; }
  .rail h2 {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }
  .rail dl { display: grid; gap: 0.5rem; }
  .rail dl > div { display: flex; justify-content: space-between; gap: 1rem; }
  .rail dt { color: var(--text-muted); }
  .rail dd { text-align: right; }
  .rail ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .rail a { color: var(--text); }
  .rail a:hover { color: var(--link); }
  @media (max-width: 980px) {
    .rail { position: static; margin-top: 0; }
  }
</style>

<script>
  // Decorative hero constellation (about-constellatie handoff).
  //
  // Everything about density is derived from the canvas area rather
  // than from breakpoints, because the previous version's failure was
  // exactly that: a fixed 140px link distance is 12% of a desktop
  // hero's width but 36% of a phone's, so on a phone nearly every
  // point could reach every other and the pattern closed up into a
  // mesh. Two rules fix it — a link distance proportional to the
  // canvas, and a hard cap of three lines per point that holds however
  // narrow the screen gets.
  function initHeroConstellation(root: HTMLElement) {
    const canvas = root.querySelector("canvas");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const MAX_EDGES = 3;
    const FRAME = 1000 / 30; // 30fps — indistinguishable at this drift speed

    interface Point { x: number; y: number; vx: number; vy: number; r: number }
    let points: Point[] = [];
    let w = 0;
    let h = 0;
    let prevW = 0;
    let prevH = 0;
    let link = 0;
    let speed = 0.15;
    let raf = 0;
    let onScreen = true;
    let last = 0;

    function measure(): boolean {
      // Capped at 2: on a dpr-3 phone the canvas would carry half as
      // many pixels again for no visible gain on 1px lines.
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const rect = canvas!.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      if (!w || !h) return false;

      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const area = w * h;
      link = Math.min(165, Math.max(88, Math.sqrt(area) * 0.22));
      speed = w < 640 ? 0.09 : 0.15;
      return true;
    }

    function seed() {
      const area = w * h;
      const count = Math.round(Math.min(70, Math.max(10, area / 9000)));
      const rMin = w < 640 ? 1.1 : 0.8; // smaller than this and they vanish on a dense screen
      points = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * speed,
        vy: (Math.random() - 0.5) * speed,
        r: Math.random() * 1.4 + rMin,
      }));
    }

    function rescale() {
      if (!prevW || !prevH) return;
      const sx = w / prevW;
      const sy = h / prevH;
      for (const p of points) {
        p.x *= sx;
        p.y *= sy;
      }
    }

    function resize() {
      if (!measure()) return;
      // The single most important line here: iOS Safari collapses and
      // expands its address bar while scrolling, which changes the
      // hero's height and fires the ResizeObserver. Reseeding on every
      // one of those would visibly reshuffle the pattern mid-scroll,
      // so only a real width change (>15%) reseeds — a rotation, say.
      // Anything smaller just scales the existing points.
      const bigChange = !points.length || Math.abs(w - prevW) > prevW * 0.15;
      bigChange ? seed() : rescale();
      prevW = w;
      prevH = h;
    }

    function draw(dt: number) {
      // Read from the canvas, not documentElement: custom properties
      // only inherit downward, so a token scoped to any wrapper would
      // read empty at the root and canvas would silently fall back to
      // opaque black.
      const styles = getComputedStyle(canvas!);
      const nodeColor = styles.getPropertyValue("--node").trim();
      const edgeColor = styles.getPropertyValue("--edge").trim();

      if (!reduced.matches) {
        const step = dt / 16.67; // time-based, so a dropped frame doesn't slow the drift
        for (const p of points) {
          p.x += p.vx * step;
          p.y += p.vy * step;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;
        }
      }

      ctx!.clearRect(0, 0, w, h);
      ctx!.strokeStyle = edgeColor;
      ctx!.lineWidth = 1;

      // The cap counts lines TOUCHING a point, not lines it started.
      // Capping only what each point originates (which is the simpler
      // reading) lets a point be picked by its neighbours on top of
      // its own three, and measured over random layouts the worst node
      // then reaches six to nine lines — the clogging this rule exists
      // to prevent. Checking both ends before drawing makes three a
      // real ceiling, at the cost of a few edges overall.
      const drawn = new Set<string>();
      const degree = new Array(points.length).fill(0);
      for (let i = 0; i < points.length; i++) {
        const a = points[i];
        const near: [number, number][] = [];
        for (let j = 0; j < points.length; j++) {
          if (i === j) continue;
          const d = Math.hypot(a.x - points[j].x, a.y - points[j].y);
          if (d < link) near.push([d, j]);
        }
        near.sort((m, n) => m[0] - n[0]); // nearest neighbours win the slots
        for (const [d, j] of near) {
          if (degree[i] >= MAX_EDGES) break;
          if (degree[j] >= MAX_EDGES) continue;
          const key = i < j ? `${i}:${j}` : `${j}:${i}`;
          if (drawn.has(key)) continue; // already counted at both ends
          drawn.add(key);
          degree[i]++;
          degree[j]++;
          ctx!.globalAlpha = (1 - d / link) * 0.5; // farther apart = fainter
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(points[j].x, points[j].y);
          ctx!.stroke();
        }
      }

      ctx!.globalAlpha = 1;
      ctx!.fillStyle = nodeColor;
      for (const p of points) {
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    function loop(t: number) {
      raf = requestAnimationFrame(loop);
      const dt = t - last;
      if (dt < FRAME) return;
      last = t;
      draw(Math.min(dt, 50)); // no jump after a pause
    }

    function start() {
      if (raf || reduced.matches || !onScreen) return;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    // The page's other motion is the disclosure bars, far below the
    // fold. These two never share the screen, and this is what keeps
    // it that way: off-screen, the loop is not running at all.
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      onScreen ? start() : stop();
    }).observe(root);

    document.addEventListener("visibilitychange", () => {
      document.hidden ? stop() : start();
    });

    new ResizeObserver(() => {
      resize();
      draw(0);
    }).observe(root);

    reduced.addEventListener("change", () => {
      stop();
      draw(0);
      start();
    });

    resize();
    draw(0);
    start();
  }

  document
    .querySelectorAll<HTMLElement>(".hero-nodes")
    .forEach(initHeroConstellation);
</script>

<script>
  // Bars fill once, the first time each row scrolls into view — the
  // only motion on the page (hero-topografie-en-about handoff).
  // Reduced motion is handled purely in CSS (the transition above is
  // dropped), so this script doesn't need to branch on it: setting
  // width still runs, it just jumps instead of animating.
  const io = new IntersectionObserver((entries, obs) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const fill = entry.target.querySelector<HTMLElement>(".fill");
      const pct = (entry.target as HTMLElement).dataset.fill;
      if (fill && pct) fill.style.width = `${pct}%`;
      obs.unobserve(entry.target);
    }
  }, { threshold: 0.5 });

  document.querySelectorAll(".scale .row").forEach((row) => io.observe(row));
</script>
