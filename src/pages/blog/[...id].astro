---
// Post URLs stay at /blog/<slug>/ — they are already indexed and
// shared, and GitHub Pages has no server-side redirects to soften a
// rename with. What gets fixed here is the *breadcrumb*: it reflects
// the post's `kind`, not the URL segment, so a Fundamentals post no
// longer announces itself as News.
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import TopicChips from "../../components/TopicChips.astro";
import HowThisWasMade from "../../components/HowThisWasMade.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import ThreadStrip from "../../components/ThreadStrip.astro";
import { CREDITS } from "../../credit";
import { FORMATS, SECTION_INFO, type Topic } from "../../taxonomy";
import { postUrl, readingMinutes, relatedPosts, threadPositions } from "../../posts";
import { SITE } from "../../consts";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const section = SECTION_INFO[data.kind];
const format = FORMATS[data.format];
const minutes = readingMinutes(post);
// Reading mode follows the FORMAT, not the section: a short timely item
// is a short timely item whether it sits in Model Updates or Security,
// and a deep dive is long-form wherever it is filed.
const longForm = data.format !== "news";

// The weaker of two posts on the same subject points at the better
// one rather than leaving the reader on it.
const betterPosts = data.betterCoveredBy
  ? await getCollection("blog", ({ id }) => id === data.betterCoveredBy)
  : [];
const better = betterPosts[0];

// Related reading prefers a *different* kind on a shared topic, so a
// news reader lands on the deep dive rather than another short item.
const related = await relatedPosts(post);
const threads = await threadPositions(post);

// Structured data has to reflect the credit model rather than assert a
// human author on everything. On a Scout post nobody wrote it in the
// sense schema.org means, so `author` is the software agent and the
// human is not named; on a directed piece Sebastiaan is the author and
// the model is credited as a contributor. Claiming a human author on
// an unreviewed auto-draft would be the one place where honesty and
// SEO happen to want the same thing, and we'd be getting it wrong.
// The @id values match the ones the homepage declares (src/pages/
// index.astro), so a crawler reads one Person and one Blog across the
// whole site rather than re-deriving a separate author entity from
// every post it happens to find first. The Person is also defined in
// full here rather than only referenced: a post page has to be
// parseable on its own, and an @id pointing at a node that is only
// declared on the homepage reads as an author with no name to anything
// that looks at this page in isolation.
const siteUrl = Astro.site?.href ?? "https://securesein.com/";
const person = {
  "@type": "Person",
  "@id": `${siteUrl}#author`,
  name: SITE.author,
  jobTitle: SITE.authorRole,
  url: `${siteUrl}about/`,
  ...(SITE.github && { sameAs: [SITE.github] }),
};
const scoutAgent = {
  "@type": "SoftwareApplication",
  "@id": `${siteUrl}#scout`,
  name: "Scout",
  applicationCategory: "Automated publishing pipeline",
  author: { "@id": `${siteUrl}#author` },
};
const isScout = data.credit === "scout";
const article = {
  "@type": "Article",
  "@id": new URL(postUrl(post), Astro.site).href + "#article",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate && { dateModified: data.updatedDate.toISOString() }),
  author: { "@id": isScout ? `${siteUrl}#scout` : `${siteUrl}#author` },
  publisher: { "@id": `${siteUrl}#author` },
  isPartOf: { "@id": `${siteUrl}#blog` },
  articleSection: section.label,
  inLanguage: "en-GB",
  ...(data.model && {
    contributor: { "@type": "SoftwareApplication", name: data.model },
  }),
  ...(data.hero && { image: new URL(data.hero, Astro.site).href }),
  ...(data.source && { isBasedOn: data.source.url }),
  mainEntityOfPage: new URL(postUrl(post), Astro.site).href,
  keywords: data.topics.join(", "),
};
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    article,
    person,
    ...(isScout ? [scoutAgent] : []),
    {
      "@type": "Blog",
      "@id": `${siteUrl}#blog`,
      url: siteUrl,
      name: SITE.title,
      publisher: { "@id": `${siteUrl}#author` },
    },
  ],
};
---
<BaseLayout
  title={data.title}
  description={data.description}
  reading={longForm}
  image={data.hero}
  imageAlt={data.heroAlt}
  ogType="article"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <meta slot="head" property="article:published_time" content={data.pubDate.toISOString()} />
  {data.updatedDate && (
    <meta slot="head" property="article:modified_time" content={data.updatedDate.toISOString()} />
  )}
  {data.topics.map((topic: string) => (
    <meta slot="head" property="article:tag" content={topic} />
  ))}

  <article class="container post" data-pagefind-body data-pagefind-meta={`section:${section.label}`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={section.href} class="crumb-kind">{section.plural}</a>
      <span class="crumb-format">{format.label}</span>
    </nav>

    <h1 class="post-title">{data.title}</h1>
    <p class="post-lead">{data.description}</p>

    <p class="post-meta">
      <span class="post-byline">{CREDITS[data.credit].byline}</span>
      <FormattedDate date={data.pubDate} />
      <span class="post-length">{minutes} min read</span>
      {data.updatedDate && (
        <span class="post-updated">
          Updated <FormattedDate date={data.updatedDate} short />
        </span>
      )}
    </p>

    <TopicChips topics={data.topics as Topic[]} />

    <HowThisWasMade
      credit={data.credit}
      contributions={data.contributions}
      model={data.model}
      source={data.source}
      pubDate={data.pubDate}
    />

    {better && (
      <aside class="crosslink">
        There is a better piece on this subject in Fundamentals:
        <a href={postUrl(better)}>{better.data.title}</a>
      </aside>
    )}

    <ThreadStrip positions={threads} />

    {data.hero && (
      <img
        class="post-hero"
        src={data.hero}
        alt={data.heroAlt}
        width="1200"
        height="630"
      />
    )}

    <div class="prose">
      <Content />
    </div>

    <ThreadStrip positions={threads} full />

    <RelatedPosts posts={related} />
  </article>
</BaseLayout>

<style>
  .post { padding-top: 2.4rem; }
  /* The kind badge is the one gradient pill on the page — the brand
     mark, the equivalent of the old section pill, in the taxonomy's own
     word. Sentence case, not tracked-out caps: the gradient carries the
     identity, so the type doesn't need to shout. The format sits beside
     it as a quiet outline pill. */
  .crumbs {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .crumb-kind {
    display: inline-block;
    padding: 0.32rem 0.85rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-ink);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    transition: filter 0.2s ease;
  }
  .crumb-kind:hover { text-decoration: none; filter: saturate(1.12) brightness(1.04); }
  .crumb-format {
    display: inline-block;
    padding: 0.32rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  /* A label now, not a link: formats have no per-format route under the
     three-axis model (the two that do, /news/ and /deep-dives/, are
     kept for URL continuity rather than as front doors). */
  .post-title {
    font-size: clamp(1.9rem, 5vw, 2.9rem);
    margin-top: 1.1rem;
    letter-spacing: -0.025em;
  }
  .post-lead {
    font-size: 1.18rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin-top: 1rem;
    max-width: 56ch;
  }
  .post-meta {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .post :global(.topic-chips) { margin-top: 1rem; }
  .post-byline { color: var(--text); font-weight: 600; }
  .crosslink {
    margin-top: 1.6rem;
    padding: 0.8rem 1rem;
    border-left: 2px solid var(--signal);
    background: var(--surface);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .crosslink a { margin-left: 0.35rem; }
  .post-hero {
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
  }
  .prose { margin-top: 2.4rem; }
</style>
