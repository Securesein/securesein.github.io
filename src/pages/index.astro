---
// The homepage's job is to teach the section model in about four
// seconds. It does that by contrast, not explanation: one long piece
// rendered large next to a dense column of short items says everything
// a paragraph would have said about the difference in weight.
//
// The featured slot is the newest long-form piece from ANY section
// (format `deepdive`, `paper` or `explainer`), and the dense column is
// the newest Model Updates items — the two extremes of the site.
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import NewsRow from "../components/NewsRow.astro";
import { SITE, SECTIONS } from "../consts";
import { allPosts, postUrl, postsOfFormat, postsOfKind, threadsWithPosts } from "../posts";

const [allPublished, releases, explainers, dives, papers, threads] = await Promise.all([
  allPosts(),
  postsOfKind("release"),
  postsOfKind("explainer"),
  postsOfFormat("deepdive"),
  postsOfFormat("paper"),
  threadsWithPosts(),
]);

const longForm = [...dives, ...papers].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = longForm[0];
const moreDives = longForm.slice(1, 3);
const latestReleases = releases.slice(0, 6);
const startHere = explainers.slice(0, 4);
const thread = threads.find(({ posts }) => posts.length > 1);
const latestPost = allPublished[0];
---
<BaseLayout>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <!-- Homepage-only typefaces (build brief: hero masthead handoff, v4 —
       "met rubriekskleuren"). Archivo loads sitewide (see BaseLayout,
       the nav wordmark uses it too); Instrument Sans and JetBrains
       Mono (the label line is back, per-category this time) are only
       used here. -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />

  <section class="masthead">
    <div class="container container--wide masthead-inner">
      <p class="masthead__eyebrow">
        <span class="masthead__rule" aria-hidden="true"></span>
        <span class="masthead__cats">
          {SECTIONS.map((section) => (
            <span class="cat" data-cat={section.kind}>{section.label}</span>
          ))}
        </span>
        <span class="masthead__rule" aria-hidden="true"></span>
      </p>

      <h1 class="masthead__title">{SITE.title}</h1>

      <p class="masthead__tagline">{SITE.subTagline}</p>

      <div class="masthead__actions">
        {latestPost && (
          <a class="btn btn--primary" href={postUrl(latestPost)}>
            Latest: {latestPost.data.title}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <line x1="4" y1="12" x2="19" y2="12" />
              <polyline points="13,6 19,12 13,18" />
            </svg>
          </a>
        )}
        <a class="btn btn--ghost" href="/about/">About this blog</a>
      </div>

      <!-- data-cat mirrors each post's `kind` frontmatter value exactly
           (see src/taxonomy.ts) rather than the handoff doc's own
           presentation-style names (model/benchmarks/fundamentals),
           so a post-kicker reuse later (doc §6) needs no mapping
           table — the whole reason that section gives for the rule
           in the first place. -->
      <nav class="sections" aria-label="Browse by section">
        {SECTIONS.map((section) => (
          <a class="section-card" data-cat={section.kind} href={section.href}>
            <span class="section-card__name">{section.label}</span>
            <span class="section-card__desc">{section.description}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container container--wide">
    <div class="split">
      <section class="split-main" aria-labelledby="featured-heading">
        <h2 class="lane-heading" id="featured-heading">
          <a href="/research/">Taken apart</a>
        </h2>
        {featured ? (
          <PostCard post={featured} featured />
        ) : (
          <p class="empty">Nothing here yet.</p>
        )}
        {moreDives.map((post) => <PostCard post={post} compact />)}
      </section>

      <section class="split-side" aria-labelledby="scout-heading">
        <h2 class="lane-heading" id="scout-heading">
          <a href="/model-updates/">Model updates</a>
        </h2>
        <div class="side-rows">
          {latestReleases.map((post) => <NewsRow post={post} terse />)}
        </div>
        <p class="side-more"><a href="/model-updates/">All model updates</a></p>
      </section>
    </div>

    {startHere.length > 0 && (
      <section class="start" aria-labelledby="start-heading">
        <h2 class="lane-heading" id="start-heading">
          <a href="/fundamentals/">Start here</a>
        </h2>
        <div class="start-grid">
          {startHere.map((post, i) => <PostCard post={post} step={i + 1} compact />)}
        </div>
      </section>
    )}

    {thread && (
      <section class="reading" aria-labelledby="reading-heading">
        <h2 class="lane-heading" id="reading-heading">Reading now</h2>
        <a href={`/threads/${thread.thread.id}/`} class="reading-link">
          <span class="reading-title">{thread.thread.data.title}</span>
          <span class="reading-count">{thread.posts.length} parts</span>
        </a>
        <p class="reading-blurb">{thread.thread.data.blurb}</p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* ---------- masthead (hero masthead handoff, v4 — "met
     rubriekskleuren"). Back to a neutral background (v3's page-wide
     violet tint is gone — see git history if that's wanted again),
     scoped to .masthead exactly like v1/v2, plus a category-colour
     system: each section gets its own hue, applied via a `data-cat`
     attribute that mirrors the post `kind` slug directly (see the
     template) so a future post-kicker reuse (doc §6, explicitly
     deferred there) needs no separate mapping table. --ink-strong is
     in the doc's own token list but never consumed by any of its
     actual rules (the wordmark uses --display instead) — left out
     here rather than kept as a dead token. */
  .masthead {
    --hairline: #e6e6ea;
    --border: #dcdce2;
    --ink: #101014;
    --ink-soft: #4f4860;
    --ink-muted: #5e5e6a;
    --label-sep: #a8a8b2;
    --display: #08080b;
    --accent: #6d3ff3;
    --accent-ink: #ffffff;

    --c-release: #6d3ff3; --c-release-ink: #6d3ff3;
    --c-research: #0b7a55; --c-research-ink: #0b7a55;
    --c-benchmark: #1a62c4; --c-benchmark-ink: #1a62c4;
    --c-security: #9a5b00; --c-security-ink: #9a5b00;
    --c-explainer: #c2185b; --c-explainer-ink: #c2185b;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .masthead {
      --hairline: #1c1c21;
      --border: #26262b;
      --ink: #f2f2f4;
      --ink-soft: #b6aedc;
      --ink-muted: #8e8e98;
      --label-sep: #4a4a54;
      --display: #ffffff;
      --accent: #a98bff;
      --accent-ink: #0a0a0c;

      --c-release: #a98bff; --c-release-ink: #c9b6ff;
      --c-research: #6fe0a8; --c-research-ink: #96ebc2;
      --c-benchmark: #6fb4ff; --c-benchmark-ink: #9ccbff;
      --c-security: #f5b851; --c-security-ink: #f8cd86;
      --c-explainer: #ff8fb4; --c-explainer-ink: #ffafca;
    }
  }
  :global(:root[data-theme="dark"]) .masthead {
    --hairline: #1c1c21;
    --border: #26262b;
    --ink: #f2f2f4;
    --ink-soft: #b6aedc;
    --ink-muted: #8e8e98;
    --label-sep: #4a4a54;
    --display: #ffffff;
    --accent: #a98bff;
    --accent-ink: #0a0a0c;

    --c-release: #a98bff; --c-release-ink: #c9b6ff;
    --c-research: #6fe0a8; --c-research-ink: #96ebc2;
    --c-benchmark: #6fb4ff; --c-benchmark-ink: #9ccbff;
    --c-security: #f5b851; --c-security-ink: #f8cd86;
    --c-explainer: #ff8fb4; --c-explainer-ink: #ffafca;
  }

  /* One place linking each real `kind` slug to its colour pair —
     .section-card and .masthead__cats .cat both just read --cat /
     --cat-ink, whichever element they land on. */
  .masthead [data-cat="release"]   { --cat: var(--c-release);   --cat-ink: var(--c-release-ink); }
  .masthead [data-cat="research"]  { --cat: var(--c-research);  --cat-ink: var(--c-research-ink); }
  .masthead [data-cat="benchmark"] { --cat: var(--c-benchmark); --cat-ink: var(--c-benchmark-ink); }
  .masthead [data-cat="security"]  { --cat: var(--c-security);  --cat-ink: var(--c-security-ink); }
  .masthead [data-cat="explainer"] { --cat: var(--c-explainer); --cat-ink: var(--c-explainer-ink); }

  .masthead-inner {
    padding-block: 4.75rem 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: "Instrument Sans", var(--font-sans);
  }

  .masthead__eyebrow {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1.375rem;
  }
  .masthead__rule { flex: 1 1 auto; height: 1px; background: var(--hairline); }

  .masthead__cats {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: "JetBrains Mono", var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .masthead__cats .cat { color: var(--cat-ink); }
  .masthead__cats .cat + .cat::before {
    content: "·";
    margin-right: 0.625rem;
    color: var(--label-sep);
  }

  .masthead__title {
    margin: 1.875rem 0 0;
    font-family: "Archivo", var(--font-sans);
    font-weight: 700;
    font-size: clamp(3.25rem, 7.8vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--display);
  }

  .masthead__tagline {
    margin: 1.25rem 0 0;
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: var(--ink-soft);
  }

  .masthead__actions {
    margin-top: 2.125rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 46px;
    padding: 0 1.375rem;
    border-radius: 23px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn--primary { background: var(--accent); color: var(--accent-ink); }
  .btn--primary:hover { filter: brightness(1.08); }
  .btn--ghost { border: 1px solid var(--border); color: var(--ink); font-weight: 500; }
  .btn--ghost:hover { border-color: var(--accent); }

  /* ---------- sections (replaces the old left-rule .lanes list) --- */
  .sections {
    width: 100%;
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.75rem;
    text-align: left;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.125rem;
    border-top: 2px solid var(--cat);
    text-decoration: none;
  }
  .section-card__name { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--cat-ink); }
  .section-card__desc { font-size: 0.875rem; line-height: 1.45; color: var(--ink-muted); }
  .section-card:hover .section-card__desc { color: var(--ink); }

  @media (max-width: 1100px) {
    .sections { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.5rem; }
  }

  @media (max-width: 860px) {
    /* Five colour-coded labels don't fit side by side any more; the
       hairline alone (its two halves now adjacent, no gap between
       them) is enough of an eyebrow, and the sections just below
       already carry the same colours anyway (doc's own reasoning). */
    .masthead__cats { display: none; }
    .masthead__eyebrow { gap: 0; }
  }

  @media (max-width: 760px) {
    .masthead-inner { padding-block: 3rem 2rem; }
    .masthead__title { margin-top: 1.5rem; }
    .masthead__tagline { max-width: 26ch; }
    .masthead__actions { margin-top: 1.75rem; width: 100%; flex-direction: column; gap: 0.75rem; }
    .btn { width: 100%; min-height: 50px; }
    .sections { margin-top: 2.5rem; display: block; }
    .section-card { gap: 0.2rem; padding: 0.8rem 0; border-top-width: 2px; }
    .section-card__desc { font-size: 0.8rem; }
  }

  .masthead a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .section-card__desc { transition: none; }
  }

  .lane-heading {
    padding-bottom: 0.5rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: none;
    color: var(--text-muted);
  }
  .lane-heading a { color: inherit; }

  /* The asymmetry is the point: one large thing, one dense list. */
  .split { display: grid; gap: 2.8rem; padding-top: 2.8rem; }
  @media (min-width: 900px) {
    .split { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 3.4rem; }
  }
  /* The featured hero is un-boxed (margin-bottom:0 in the component); a
     list of deep-dive cards follows it here, so give it room — otherwise
     the first card is glued to the featured's topic chips. */
  .split-main > :global(.card--featured) { margin-bottom: 2.6rem; }
  .split-side { min-width: 0; }
  .side-rows :global(.news-row:first-of-type) { border-top: none; }
  .side-more { margin-top: 1rem; font-size: 0.86rem; }

  .start { padding-top: 3.2rem; }
  .start-grid { display: grid; gap: 0 2.6rem; }
  @media (min-width: 720px) {
    .start-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .reading {
    margin-top: 3.2rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--signal);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .reading .lane-heading { border-bottom-color: color-mix(in srgb, var(--rule) 60%, transparent); }
  .reading-link { display: flex; align-items: baseline; gap: 1rem; color: var(--text); }
  .reading-title { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.015em; }
  .reading-count {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .reading-blurb {
    margin-top: 0.6rem;
    max-width: 68ch;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .empty { color: var(--text-muted); padding-block: 2rem; }
</style>
