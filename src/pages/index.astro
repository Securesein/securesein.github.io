---
// The homepage's job is to teach the section model in about four
// seconds. It does that by contrast, not explanation: one long piece
// rendered large next to a dense column of short items says everything
// a paragraph would have said about the difference in weight.
//
// The featured slot is the newest long-form piece from ANY section
// (format `deepdive`, `paper` or `explainer`), and the dense column is
// the newest Model Updates items — the two extremes of the site.
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import NewsRow from "../components/NewsRow.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { SITE, SECTIONS, HERO_BACKGROUND } from "../consts";
import { allPosts, postUrl, postsOfFormat, postsOfKind, threadsWithPosts } from "../posts";

const [allPublished, releases, explainers, dives, papers, threads] = await Promise.all([
  allPosts(),
  postsOfKind("release"),
  postsOfKind("explainer"),
  postsOfFormat("deepdive"),
  postsOfFormat("paper"),
  threadsWithPosts(),
]);

const longForm = [...dives, ...papers].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = longForm[0];
const moreDives = longForm.slice(1, 3);
const latestReleases = releases.slice(0, 6);
const startHere = explainers.slice(0, 4);
const thread = threads.find(({ posts }) => posts.length > 1);
const latestPost = allPublished[0];
const sectionsEyebrow = SECTIONS.map((s) => s.label).join(" · ");

// Site-level structured data. Post pages already declare themselves as
// Articles; this is the piece that was missing — what the SITE is, and
// who is behind it, so the two aren't inferred separately from every
// individual post. Deliberately no SearchAction: the search page runs
// Pagefind client-side and does not read a ?q= parameter, so claiming a
// query template Google could hand a term to would be a promise the
// site doesn't keep.
const siteUrl = Astro.site?.href ?? "https://securesein.com/";
const author = {
  "@type": "Person",
  "@id": `${siteUrl}#author`,
  name: SITE.author,
  jobTitle: SITE.authorRole,
  url: `${siteUrl}about/`,
  ...(SITE.github && { sameAs: [SITE.github] }),
};
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: SITE.title,
      description: SITE.description,
      inLanguage: "en-GB",
      publisher: { "@id": `${siteUrl}#author` },
    },
    {
      "@type": "Blog",
      "@id": `${siteUrl}#blog`,
      url: siteUrl,
      name: SITE.title,
      description: SITE.description,
      inLanguage: "en-GB",
      author: { "@id": `${siteUrl}#author` },
      publisher: { "@id": `${siteUrl}#author` },
    },
    author,
  ],
};
---
<BaseLayout>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(siteJsonLd)}
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <!-- Homepage-only typeface: Instrument Sans (the masthead's tagline
       and buttons). Archivo and JetBrains Mono now load sitewide (see
       BaseLayout) since the nav wordmark and the Eyebrow component
       (design handoff) both use them on every page. -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
  />

  <!-- v5: like v3, the tint spans the whole homepage (doc §3/§7: no
       seam below the hero), scoped so it never reaches the nav,
       footer or any other page — see the style block. -->
  <div class="mh-page">
    <section class="masthead" data-hero-bg={HERO_BACKGROUND}>
      <div class="container container--wide masthead-inner">
        <Eyebrow center label={sectionsEyebrow} />

        <h1 class="masthead__title">{SITE.title}</h1>

        <p class="masthead__tagline">{SITE.subTagline}</p>

        <div class="masthead__actions">
          {latestPost && (
            <a class="btn btn--primary btn--latest" href={postUrl(latestPost)}>
              <span class="btn__label">Latest</span>
              <span class="btn__prefix">Latest: </span>
              <span class="btn__title">{latestPost.data.title}</span>
              <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <line x1="4" y1="12" x2="19" y2="12" />
                <polyline points="13,6 19,12 13,18" />
              </svg>
            </a>
          )}
          <a class="btn btn--brand" href="/about/">About this blog</a>
        </div>

        <nav class="sections" aria-label="Browse by section">
          {SECTIONS.map((section, i) => (
            <a
              class:list={["section-card", { "section-card--lead": i === 0 }]}
              href={section.href}
            >
              <span class="section-card__name">{section.label}</span>
              <span class="section-card__desc">{section.description}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <div class="container container--wide">
      <div class="split">
        <section class="split-main" aria-labelledby="featured-heading">
          <h2 class="lane-heading" id="featured-heading">
            <a href="/research/">Taken apart</a>
          </h2>
          {featured ? (
            <PostCard post={featured} featured />
          ) : (
            <p class="empty">Nothing here yet.</p>
          )}
          {moreDives.map((post) => <PostCard post={post} compact />)}
        </section>

        <section class="split-side" aria-labelledby="scout-heading">
          <h2 class="lane-heading" id="scout-heading">
            <a href="/model-updates/">Model updates</a>
          </h2>
          <div class="side-rows">
            {latestReleases.map((post) => <NewsRow post={post} terse />)}
          </div>
          <p class="side-more"><a href="/model-updates/">All model updates</a></p>
        </section>
      </div>

      {startHere.length > 0 && (
        <section class="start" aria-labelledby="start-heading">
          <h2 class="lane-heading" id="start-heading">
            <a href="/fundamentals/">Start here</a>
          </h2>
          <div class="start-grid">
            {startHere.map((post, i) => <PostCard post={post} step={i + 1} compact />)}
          </div>
        </section>
      )}

      {thread && (
        <section class="reading" aria-labelledby="reading-heading">
          <h2 class="lane-heading" id="reading-heading">Reading now</h2>
          <a href={`/threads/${thread.thread.id}/`} class="reading-link">
            <span class="reading-title">{thread.thread.data.title}</span>
            <span class="reading-count">{thread.posts.length} parts</span>
          </a>
          <p class="reading-blurb">{thread.thread.data.blurb}</p>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- page-wide warm tint (hero masthead handoff, v5 —
     "amber variant"). Back to a page-wide tint like v3 (v4's neutral
     bg + per-section colours is gone — see git history), but amber
     (--accent, the primary button + eyebrow label) against violet
     (--brand, the secondary button's border/text + focus ring +
     nav-star), two roles only, deliberately not reused anywhere else
     (doc §2/§9 — a third accent or either one bleeding into the
     other's job is exactly what makes it unreadable).

     Same technique as v3: re-declare the actual semantic tokens
     (--bg, --text, --text-muted, --border, --border-strong), not just
     the base ones they're derived from — a var() reference resolves
     once, at whichever rule declares it, and only :root declares
     --bg: var(--paper), so a descendant overriding --paper alone
     wouldn't change what --bg resolves to for anything already
     reading --bg. --card-border is new: the doc's section-card border
     uses its own literal value rather than the color-mix'd
     --border-strong PostCard/NewsRow already read, so it gets its own
     token instead of overloading that one with a different meaning. */
  .mh-page {
    /* Was #fffdfb, a hair of warmth across the whole homepage. The
       panel now carries that warmth in the hero alone, so the body of
       the page matches every other page's white exactly rather than
       being almost-but-not-quite it. */
    --paper: #ffffff;
    --ink: #16130f;
    --rule: #ede8e2;
    --muted: #5e584f;
    --surface: #f7f4f0;
    --bg: var(--paper);
    --text: var(--ink);
    --text-muted: var(--muted);
    --border: var(--rule);
    --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

    --ink-soft: #4b463f;
    --display: #0c0a08;
    --accent: #e09a2b;
    --accent-ink: #1a1206;
    --brand: #6d3ff3;
    --brand-ink: #6d3ff3;
    --card-border: #ded8d1;

    /* Topography hero background (hero-topografie-en-about handoff):
       mixed from --brand/--accent/--ink rather than given their own
       hardcoded per-theme hex pair, for the same reason --node/--edge
       (the constellation background this replaces) were — .mh-page
       redeclares --brand/--accent/--ink for itself in all three blocks
       below, so a color-mix() referencing them resolves against THIS
       element's own cascade and inherits that correctness for free. */
    --topo: color-mix(in srgb, var(--ink) 9%, transparent);
    --glow-a: color-mix(in srgb, var(--brand) 15%, transparent);
    --glow-b: color-mix(in srgb, var(--accent) 12%, transparent);

    /* Dot-matrix variant (dotmatrix handoff A2). Literal in light,
       unlike the tokens above, because the light and dark sweeps are
       not the same colour doing the same job: dark adds violet light
       to a dark field, light multiplies a warm brown into the panel
       so the sweep thickens ink instead of hazing it. There is no one
       hue to derive both from. */
    --dot: rgba(38, 29, 14, 0.15);
    --sheen: rgba(160, 118, 58, 0.2);

    background: var(--bg);
    color: var(--text);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .mh-page {
      --paper: #0b0a0a;
      --ink: #f4f1ef;
      --rule: #241f1b;
      --muted: #95908a;
      --surface: #131110;
      --bg: var(--paper);
      --text: var(--ink);
      --text-muted: var(--muted);
      --border: var(--rule);
      --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

      --ink-soft: #b7b0a8;
      --display: #ffffff;
      --accent: #f5b851;
      --accent-ink: #0b0a0a;
      --brand: #a98bff;
      --brand-ink: #c9b6ff;
      --card-border: #2b2724;

      --topo: color-mix(in srgb, var(--ink) 8%, transparent);
      --glow-a: color-mix(in srgb, var(--brand) 20%, transparent);
      --glow-b: color-mix(in srgb, var(--accent) 12%, transparent);

      --dot: color-mix(in srgb, var(--ink) 14%, transparent);
      --sheen: color-mix(in srgb, var(--brand) 12%, transparent);
    }
  }
  :global(:root[data-theme="dark"]) .mh-page {
    --paper: #0b0a0a;
    --ink: #f4f1ef;
    --rule: #241f1b;
    --muted: #95908a;
    --surface: #131110;
    --bg: var(--paper);
    --text: var(--ink);
    --text-muted: var(--muted);
    --border: var(--rule);
    --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

    --ink-soft: #b7b0a8;
    --display: #ffffff;
    --accent: #f5b851;
    --accent-ink: #0b0a0a;
    --brand: #a98bff;
    --brand-ink: #c9b6ff;
    --card-border: #2b2724;

    --topo: color-mix(in srgb, var(--ink) 8%, transparent);
    --glow-a: color-mix(in srgb, var(--brand) 20%, transparent);
    --glow-b: color-mix(in srgb, var(--accent) 12%, transparent);

    --dot: color-mix(in srgb, var(--ink) 14%, transparent);
    --sheen: color-mix(in srgb, var(--brand) 12%, transparent);
  }

  /* Two hero backgrounds live here; which one renders is decided by
     HERO_BACKGROUND in consts.ts, stamped onto the section as
     data-hero-bg. Only the matching rules apply, so switching between
     them (or back) needs no other change. isolation:isolate keeps the
     pseudo-elements' z-index:-1 scoped to this section rather than
     punching through to .mh-page; overflow:hidden clips whatever
     overmat either background asks for. */
  /* The panel (light-mode-paneel handoff §3). Both values resolve to
     nothing in dark mode, so this one rule serves both. isolation is
     now load-bearing rather than tidy: without it the multiply sweep
     below would multiply against everything behind the hero instead
     of against the panel alone. */
  .masthead {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--hero-surface);
    /* An inset shadow rather than a border-bottom: --hero-edge is
       transparent in dark, but a transparent border still occupies
       its 1px, which pushed everything below the hero down by a pixel
       and made dark mode not quite identical any more. A shadow draws
       the panel's edge without taking up any layout. */
    box-shadow: inset 0 -1px 0 var(--hero-edge);
  }

  /* --- "topo": warped contour lines, static (hero-topografie
     handoff). The -30% overmat is what feDisplacementMap needs — it
     pulls edges inward, so without it the warp visibly tapers off at
     the sides. */
  .masthead[data-hero-bg="topo"]::before {
    content: "";
    position: absolute;
    inset: -30%;
    z-index: -1;
    background: repeating-radial-gradient(
      ellipse 58% 50% at 50% 42%,
      transparent 0 24px,
      var(--topo) 24px 25px
    );
    filter: url(#seinWarp);
    -webkit-mask-image: radial-gradient(ellipse 74% 66% at 50% 38%, #000 18%, transparent 78%);
            mask-image: radial-gradient(ellipse 74% 66% at 50% 38%, #000 18%, transparent 78%);
  }

  .masthead[data-hero-bg="topo"]::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 52% 44% at 50% -6%, var(--glow-a), transparent 72%),
      radial-gradient(ellipse 42% 34% at 80% 46%, var(--glow-b), transparent 72%);
  }

  /* --- "dots": a regular dot matrix with one slow sheen crossing it
     (dotmatrix handoff A3). The sweep is a transform on its own layer
     so it runs on the compositor — deliberately no filter or
     box-shadow on it, which would throw that away and repaint the
     hero every frame. */
  .masthead[data-hero-bg="dots"]::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 72% 62% at 50% 34%, #000 8%, transparent 74%);
            mask-image: radial-gradient(ellipse 72% 62% at 50% 34%, #000 8%, transparent 74%);
  }

  .masthead[data-hero-bg="dots"]::after {
    content: "";
    position: absolute;
    inset: -30%;
    z-index: -1;
    background: linear-gradient(112deg, transparent 42%, var(--sheen) 50%, transparent 58%);
    /* multiply in light, normal in dark. The transparent stops leave
       the panel untouched either way, so no extra mask is needed. */
    mix-blend-mode: var(--sweep-blend);
    animation: heroSweep 16s linear infinite;
  }

  @keyframes heroSweep {
    from { transform: translateX(-30%); }
    to   { transform: translateX(30%); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Still drawn, just not moving — the dots are the background, not
       the animation (dotmatrix handoff C2). */
    .masthead[data-hero-bg="dots"]::after { animation: none; }
  }

  @media print {
    .masthead { background: none; box-shadow: none; }
    .masthead::before, .masthead::after { display: none; }
  }

  .masthead-inner {
    padding-block: 6.5rem 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: "Instrument Sans", var(--font-sans);
  }

  .masthead__title {
    margin: 1.875rem 0 0;
    font-family: "Archivo", var(--font-sans);
    font-weight: 700;
    font-size: clamp(3.25rem, 7.8vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--display);
  }

  .masthead__tagline {
    margin: 1.25rem 0 0;
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: var(--ink-soft);
  }

  .masthead__actions {
    margin-top: 2.125rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 46px;
    padding: 0 1.375rem;
    border-radius: 23px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn--primary { background: var(--accent); color: var(--accent-ink); }
  .btn--primary:hover { filter: brightness(1.06); }
  .btn--brand { border: 1px solid var(--brand); color: var(--brand-ink); font-weight: 500; }
  .btn--brand:hover { background: color-mix(in srgb, var(--brand) 12%, transparent); }

  /* Split into label/prefix/title so the mobile layout (below) can
     turn "Latest: <title>" into a two-line block with the arrow
     folded into the text flow, without duplicating the link markup. */
  .btn__label { display: none; }

  /* ---------- sections (replaces the old left-rule .lanes list) --- */
  .sections {
    width: 100%;
    margin-top: 6rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.75rem;
    text-align: left;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.125rem;
    border-top: 2px solid var(--card-border);
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .section-card--lead { border-top-color: var(--accent); }
  .section-card:hover { border-top-color: var(--accent); }
  .section-card__name { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .section-card__desc { font-size: 0.875rem; line-height: 1.45; color: var(--text-muted); }

  @media (max-width: 1100px) {
    .sections { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.5rem; }
  }

  /* mobiel-homepage-fixes #3/#4/#5 — desktop (>700px) is untouched;
     everything below only takes effect under this breakpoint. */
  @media (max-width: 700px) {
    .masthead-inner { padding-block: 3.5rem 4rem; }
    .masthead__title { margin-top: 1.5rem; }
    .masthead__tagline { max-width: 26ch; margin: 1.25rem 0 1.875rem; font-size: 1.125rem; }

    /* #3: the contour warp tuned for a desktop-width hero flings
       lines far enough at ~390px to cross each other — swap in the
       gentler #seinWarpSm filter, widen/flatten the ring ellipse and
       space the rings out so fewer of them fit across the narrower
       width, and give the mask more overmatting room since it eats
       into the edges more aggressively at this scale. */
    .masthead[data-hero-bg="topo"]::before {
      inset: -45%;
      background: repeating-radial-gradient(
        ellipse 78% 44% at 50% 38%,
        transparent 0 34px,
        var(--topo) 34px 35px
      );
      filter: url(#seinWarpSm);
    }
    .masthead[data-hero-bg="topo"]::after {
      background:
        radial-gradient(ellipse 80% 30% at 50% -4%, var(--glow-a), transparent 72%),
        radial-gradient(ellipse 70% 26% at 70% 52%, var(--glow-b), transparent 72%);
    }

    /* Tighter grid, and a slower sweep: the same speed across less
       width reads as hurried (dotmatrix handoff A4). */
    .masthead[data-hero-bg="dots"]::before {
      background-size: 20px 20px;
      -webkit-mask-image: radial-gradient(ellipse 88% 50% at 50% 32%, #000 6%, transparent 72%);
              mask-image: radial-gradient(ellipse 88% 50% at 50% 32%, #000 6%, transparent 72%);
    }
    .masthead[data-hero-bg="dots"]::after { animation-duration: 22s; }

    /* #4: actions stack, and the "Latest" pill becomes a two-line
       block (small label over the title) instead of one long line
       with an arrow floating off to the side. */
    .masthead__actions { margin-top: 0; width: 100%; flex-direction: column; gap: 0.625rem; }
    .btn { width: 100%; min-height: 50px; }

    .btn--latest {
      display: grid;
      justify-items: start;
      gap: 0.25rem;
      padding: 0.9375rem 1.25rem;
      border-radius: 18px;
      text-align: left;
      min-height: 0;
    }
    .btn--latest .btn__label {
      display: block;
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.72;
    }
    .btn--latest .btn__prefix { display: none; }
    .btn--latest .btn__title {
      font-size: 0.97rem;
      line-height: 1.35;
      font-weight: 500;
    }
    .btn--latest .btn__title::after { content: " \2192"; white-space: nowrap; }
    .btn--latest .btn__arrow { display: none; }

    /* #5: a compact row list instead of five desktop-spaced blocks. */
    .sections { margin-top: 3rem; display: block; }
    .section-card {
      display: grid;
      gap: 0.25rem;
      padding: 0.8125rem 0;
      border-top-width: 1px;
      min-height: 44px;
    }
    .section-card--lead { border-top-width: 2px; }
    .section-card__name { font-size: 0.97rem; }
    .section-card__desc { font-size: 0.84rem; }
  }

  .masthead a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .section-card { transition: none; }
  }

  .lane-heading {
    padding-bottom: 0.5rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: none;
    color: var(--text-muted);
  }
  .lane-heading a { color: inherit; }

  /* The asymmetry is the point: one large thing, one dense list. */
  .split { display: grid; gap: 2.8rem; padding-top: 2.8rem; }
  @media (min-width: 900px) {
    .split { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 3.4rem; }
  }
  /* The featured hero is un-boxed (margin-bottom:0 in the component); a
     list of deep-dive cards follows it here, so give it room — otherwise
     the first card is glued to the featured's topic chips. */
  .split-main > :global(.card--featured) { margin-bottom: 2.6rem; }
  .split-side { min-width: 0; }
  .side-rows :global(.news-row:first-of-type) { border-top: none; }
  .side-more { margin-top: 1rem; font-size: 0.86rem; }

