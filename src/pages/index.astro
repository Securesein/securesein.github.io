---
// The homepage's job is to teach the section model in about four
// seconds. It does that by contrast, not explanation: one long piece
// rendered large next to a dense column of short items says everything
// a paragraph would have said about the difference in weight.
//
// The featured slot is the newest long-form piece from ANY section
// (format `deepdive`, `paper` or `explainer`), and the dense column is
// the newest Model Updates items — the two extremes of the site.
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import NewsRow from "../components/NewsRow.astro";
import { SITE, SECTIONS } from "../consts";
import { allPosts, postUrl, postsOfFormat, postsOfKind, threadsWithPosts } from "../posts";

const [allPublished, releases, explainers, dives, papers, threads] = await Promise.all([
  allPosts(),
  postsOfKind("release"),
  postsOfKind("explainer"),
  postsOfFormat("deepdive"),
  postsOfFormat("paper"),
  threadsWithPosts(),
]);

const longForm = [...dives, ...papers].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = longForm[0];
const moreDives = longForm.slice(1, 3);
const latestReleases = releases.slice(0, 6);
const startHere = explainers.slice(0, 4);
const thread = threads.find(({ posts }) => posts.length > 1);
const latestPost = allPublished[0];
const sectionsEyebrow = SECTIONS.map((s) => s.label).join(" · ");
---
<BaseLayout>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <!-- Masthead-only typefaces (build brief: hero masthead handoff).
       Loaded here rather than in BaseLayout because nothing outside
       this one homepage section uses them — Inter and Source Serif
       still carry the rest of the site. -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />

  <section class="masthead">
    <div class="container container--wide masthead-inner">
      <p class="masthead__eyebrow">
        <span class="masthead__rule" aria-hidden="true"></span>
        <span class="masthead__eyebrow-long">{sectionsEyebrow}</span>
        <span class="masthead__eyebrow-short">Research · Benchmarks · Security</span>
        <span class="masthead__rule" aria-hidden="true"></span>
      </p>

      <h1 class="masthead__title">{SITE.title}</h1>

      <p class="masthead__tagline">
        <svg class="masthead__flourish" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 1.2 L14.3 9.7 L22.8 12 L14.3 14.3 L12 22.8 L9.7 14.3 L1.2 12 L9.7 9.7 Z" />
        </svg>
        <span>{SITE.subTagline}</span>
        <svg class="masthead__flourish" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 1.2 L14.3 9.7 L22.8 12 L14.3 14.3 L12 22.8 L9.7 14.3 L1.2 12 L9.7 9.7 Z" />
        </svg>
      </p>

      <div class="masthead__actions">
        {latestPost && (
          <a class="btn btn--primary" href={postUrl(latestPost)}>
            Latest: {latestPost.data.title}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <line x1="4" y1="12" x2="19" y2="12" />
              <polyline points="13,6 19,12 13,18" />
            </svg>
          </a>
        )}
        <a class="btn btn--ghost" href="/about/">About this blog</a>
      </div>

      <nav class="sections" aria-label="Browse by section">
        {SECTIONS.map((section, i) => (
          <a
            class:list={["section-card", { "section-card--lead": i === 0 }]}
            href={section.href}
          >
            <span class="section-card__name">{section.label}</span>
            <span class="section-card__desc">{section.description}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container container--wide">
    <div class="split">
      <section class="split-main" aria-labelledby="featured-heading">
        <h2 class="lane-heading" id="featured-heading">
          <a href="/research/">Taken apart</a>
        </h2>
        {featured ? (
          <PostCard post={featured} featured />
        ) : (
          <p class="empty">Nothing here yet.</p>
        )}
        {moreDives.map((post) => <PostCard post={post} compact />)}
      </section>

      <section class="split-side" aria-labelledby="scout-heading">
        <h2 class="lane-heading" id="scout-heading">
          <a href="/model-updates/">Model updates</a>
        </h2>
        <div class="side-rows">
          {latestReleases.map((post) => <NewsRow post={post} terse />)}
        </div>
        <p class="side-more"><a href="/model-updates/">All model updates</a></p>
      </section>
    </div>

    {startHere.length > 0 && (
      <section class="start" aria-labelledby="start-heading">
        <h2 class="lane-heading" id="start-heading">
          <a href="/fundamentals/">Start here</a>
        </h2>
        <div class="start-grid">
          {startHere.map((post, i) => <PostCard post={post} step={i + 1} compact />)}
        </div>
      </section>
    )}

    {thread && (
      <section class="reading" aria-labelledby="reading-heading">
        <h2 class="lane-heading" id="reading-heading">Reading now</h2>
        <a href={`/threads/${thread.thread.id}/`} class="reading-link">
          <span class="reading-title">{thread.thread.data.title}</span>
          <span class="reading-count">{thread.posts.length} parts</span>
        </a>
        <p class="reading-blurb">{thread.thread.data.blurb}</p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* ---------- masthead (build brief: hero masthead handoff) ----------
     Its own small palette, scoped to .masthead and named --mh-* so
     these values can never leak into or collide with the sitewide
     tokens in global.css — "everything below the hero stays as it
     is" only holds if this component's colours stop at its own
     boundary. Light values are the defaults (matching how global.css
     itself treats light as the base palette); the dark overrides below
     mirror the exact :root:not([data-theme="light"]) / [data-theme]
     pattern already used there and in ThemeToggle.astro. The one
     departure from the handoff doc: no separate --mh-bg — the
     masthead sits directly on the page's existing --bg rather than
     introducing a second background color next to it. */
  .masthead {
    --mh-hairline: #e6e6ea;
    --mh-border: #dcdce2;
    --mh-ink-strong: #08080b;
    --mh-ink: #101014;
    --mh-ink-soft: #4c4c57;
    --mh-ink-muted: #5e5e6a;
    --mh-accent: #6d3ff3;
    --mh-accent-ink: #ffffff;
    border-bottom: 1px solid var(--rule);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .masthead {
      --mh-hairline: #1c1c21;
      --mh-border: #26262b;
      --mh-ink-strong: #ffffff;
      --mh-ink: #f2f2f4;
      --mh-ink-soft: #b4b4be;
      --mh-ink-muted: #8e8e98;
      --mh-accent: #a98bff;
      --mh-accent-ink: #0a0a0c;
    }
  }
  :global(:root[data-theme="dark"]) .masthead {
    --mh-hairline: #1c1c21;
    --mh-border: #26262b;
    --mh-ink-strong: #ffffff;
    --mh-ink: #f2f2f4;
    --mh-ink-soft: #b4b4be;
    --mh-ink-muted: #8e8e98;
    --mh-accent: #a98bff;
    --mh-accent-ink: #0a0a0c;
  }

  .masthead-inner {
    padding-block: 4.5rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: "Instrument Sans", var(--font-sans);
  }

  .masthead__eyebrow {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-family: "JetBrains Mono", var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mh-ink-muted);
  }
  .masthead__rule { flex: 1 1 auto; height: 1px; background: var(--mh-hairline); }
  .masthead__eyebrow-short { display: none; }

  .masthead__title {
    margin: 2.1rem 0 0;
    font-family: "Bricolage Grotesque", var(--font-sans);
    font-optical-sizing: auto;
    font-weight: 800;
    font-size: clamp(3.875rem, 12.9vw, 11.625rem);
    line-height: 0.86;
    letter-spacing: -0.06em;
    color: var(--mh-ink-strong);
  }

  .masthead__tagline {
    margin: 1.6rem 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    max-width: 28ch;
    font-size: clamp(1.1875rem, 1.9vw, 1.625rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--mh-ink-soft);
  }
  .masthead__flourish { flex: 0 0 auto; width: 16px; height: 16px; fill: var(--mh-accent); }

  .masthead__actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 50px;
    padding: 0 1.5rem;
    border-radius: 25px;
    font-size: 0.94rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn--primary { background: var(--mh-accent); color: var(--mh-accent-ink); }
  .btn--primary:hover { filter: brightness(1.08); }
  .btn--ghost { border: 1px solid var(--mh-border); color: var(--mh-ink-soft); font-weight: 500; }
  .btn--ghost:hover { border-color: var(--mh-accent); color: var(--mh-ink); }

  /* ---------- sections (replaces the old left-rule .lanes list) --- */
  .sections {
    width: 100%;
    margin-top: 4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.75rem;
    text-align: left;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--mh-border);
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .section-card:hover { border-top-color: var(--mh-accent); text-decoration: none; }
  .section-card--lead { border-top-color: var(--mh-accent); }
  .section-card__name { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; color: var(--mh-ink); }
  .section-card__desc { font-size: 0.86rem; line-height: 1.45; color: var(--mh-ink-muted); }

  @media (max-width: 760px) {
    .masthead-inner { padding-block: 2.75rem 2rem; }
    .masthead__eyebrow { gap: 0.75rem; font-size: 0.625rem; letter-spacing: 0.2em; }
    .masthead__eyebrow-long { display: none; }
    .masthead__eyebrow-short { display: inline; }
    .masthead__title { margin-top: 1.6rem; letter-spacing: -0.055em; }
    .masthead__tagline { flex-direction: column; gap: 0.9rem; margin-top: 1.25rem; max-width: 24ch; }
    .masthead__flourish:last-child { display: none; }
    .masthead__actions { margin-top: 1.9rem; width: 100%; flex-direction: column; gap: 0.75rem; }
    .btn { width: 100%; min-height: 52px; }
    .sections { margin-top: 2.75rem; display: block; }
    .section-card { gap: 0.2rem; padding: 0.8rem 0; border-top-width: 1px; }
    .section-card--lead { border-top-width: 2px; }
    .section-card__name { font-size: 1rem; }
    .section-card__desc { font-size: 0.8rem; }
  }

  .masthead a:focus-visible {
    outline: 2px solid var(--mh-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .section-card { transition: none; }
  }

  .lane-heading {
    padding-bottom: 0.5rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: none;
    color: var(--text-muted);
  }
  .lane-heading a { color: inherit; }

  /* The asymmetry is the point: one large thing, one dense list. */
  .split { display: grid; gap: 2.8rem; padding-top: 2.8rem; }
  @media (min-width: 900px) {
    .split { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 3.4rem; }
  }
  /* The featured hero is un-boxed (margin-bottom:0 in the component); a
     list of deep-dive cards follows it here, so give it room — otherwise
     the first card is glued to the featured's topic chips. */
  .split-main > :global(.card--featured) { margin-bottom: 2.6rem; }
  .split-side { min-width: 0; }
  .side-rows :global(.news-row:first-of-type) { border-top: none; }
  .side-more { margin-top: 1rem; font-size: 0.86rem; }

  .start { padding-top: 3.2rem; }
  .start-grid { display: grid; gap: 0 2.6rem; }
  @media (min-width: 720px) {
    .start-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .reading {
    margin-top: 3.2rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--signal);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .reading .lane-heading { border-bottom-color: color-mix(in srgb, var(--rule) 60%, transparent); }
  .reading-link { display: flex; align-items: baseline; gap: 1rem; color: var(--text); }
  .reading-title { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.015em; }
  .reading-count {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .reading-blurb {
    margin-top: 0.6rem;
    max-width: 68ch;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .empty { color: var(--text-muted); padding-block: 2rem; }
</style>
