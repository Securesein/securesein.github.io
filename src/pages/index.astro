---
// The homepage's job is to teach the section model in about four
// seconds. It does that by contrast, not explanation: one long piece
// rendered large next to a dense column of short items says everything
// a paragraph would have said about the difference in weight.
//
// The featured slot is the newest long-form piece from ANY section
// (format `deepdive`, `paper` or `explainer`), and the dense column is
// the newest Model Updates items — the two extremes of the site.
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import NewsRow from "../components/NewsRow.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { SITE, SECTIONS, HERO_BACKGROUND } from "../consts";
import { allPosts, postUrl, postsOfFormat, postsOfKind, threadsWithPosts } from "../posts";

const [allPublished, releases, explainers, dives, papers, threads] = await Promise.all([
  allPosts(),
  postsOfKind("release"),
  postsOfKind("explainer"),
  postsOfFormat("deepdive"),
  postsOfFormat("paper"),
  threadsWithPosts(),
]);

const longForm = [...dives, ...papers].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = longForm[0];
const moreDives = longForm.slice(1, 3);
const latestReleases = releases.slice(0, 6);
const startHere = explainers.slice(0, 4);
const thread = threads.find(({ posts }) => posts.length > 1);
const latestPost = allPublished[0];
const sectionsEyebrow = SECTIONS.map((s) => s.label).join(" · ");

// Site-level structured data. Post pages already declare themselves as
// Articles; this is the piece that was missing — what the SITE is, and
// who is behind it, so the two aren't inferred separately from every
// individual post. Deliberately no SearchAction: the search page runs
// Pagefind client-side and does not read a ?q= parameter, so claiming a
// query template Google could hand a term to would be a promise the
// site doesn't keep.
const siteUrl = Astro.site?.href ?? "https://securesein.com/";
const author = {
  "@type": "Person",
  "@id": `${siteUrl}#author`,
  name: SITE.author,
  jobTitle: SITE.authorRole,
  url: `${siteUrl}about/`,
  ...(SITE.github && { sameAs: [SITE.github] }),
};
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: SITE.title,
      description: SITE.description,
      inLanguage: "en-GB",
      publisher: { "@id": `${siteUrl}#author` },
    },
    {
      "@type": "Blog",
      "@id": `${siteUrl}#blog`,
      url: siteUrl,
      name: SITE.title,
      description: SITE.description,
      inLanguage: "en-GB",
      author: { "@id": `${siteUrl}#author` },
      publisher: { "@id": `${siteUrl}#author` },
    },
    author,
  ],
};
---
<BaseLayout>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(siteJsonLd)}
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <!-- Homepage-only typeface: Instrument Sans (the masthead's tagline
       and buttons). Archivo and JetBrains Mono now load sitewide (see
       BaseLayout) since the nav wordmark and the Eyebrow component
       (design handoff) both use them on every page. -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
  />

  <!-- v5: like v3, the tint spans the whole homepage (doc §3/§7: no
       seam below the hero), scoped so it never reaches the nav,
       footer or any other page — see the style block. -->
  <div class="mh-page">
    <section class="masthead" data-hero-bg={HERO_BACKGROUND}>
      <div class="masthead__fx" aria-hidden="true"></div>
      <div class="container container--wide masthead-inner">
        <Eyebrow center label={sectionsEyebrow} />

        <h1 class="masthead__title">{SITE.title}</h1>

        <p class="masthead__tagline">{SITE.subTagline}</p>

        <div class="masthead__actions">
          {latestPost && (
            <a class="btn btn--primary btn--latest" href={postUrl(latestPost)}>
              <span class="btn__label">Latest</span>
              <span class="btn__prefix">Latest: </span>
              <span class="btn__title">{latestPost.data.title}</span>
              <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <line x1="4" y1="12" x2="19" y2="12" />
                <polyline points="13,6 19,12 13,18" />
              </svg>
            </a>
          )}
          <a class="btn btn--brand" href="/about/">About this blog</a>
        </div>

        <nav class="sections" aria-label="Browse by section">
          {SECTIONS.map((section, i) => (
            <a
              class:list={["section-card", { "section-card--lead": i === 0 }]}
              href={section.href}
            >
              <span class="section-card__name">{section.label}</span>
              <span class="section-card__desc">{section.description}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <div class="container container--wide">
      <div class="split">
        <section class="split-main" aria-labelledby="featured-heading">
          <h2 class="lane-heading" id="featured-heading">
            <a href="/research/">Taken apart</a>
          </h2>
          {featured ? (
            <PostCard post={featured} featured />
          ) : (
            <p class="empty">Nothing here yet.</p>
          )}
          {moreDives.map((post) => <PostCard post={post} compact />)}
        </section>

        <section class="split-side" aria-labelledby="scout-heading">
          <h2 class="lane-heading" id="scout-heading">
            <a href="/model-updates/">Model updates</a>
          </h2>
          <div class="side-rows">
            {latestReleases.map((post) => <NewsRow post={post} terse />)}
          </div>
          <p class="side-more"><a href="/model-updates/">All model updates</a></p>
        </section>
      </div>

      {startHere.length > 0 && (
        <section class="start" aria-labelledby="start-heading">
          <h2 class="lane-heading" id="start-heading">
            <a href="/fundamentals/">Start here</a>
          </h2>
          <div class="start-grid">
            {startHere.map((post, i) => <PostCard post={post} step={i + 1} compact />)}
          </div>
        </section>
      )}

      {thread && (
        <section class="reading" aria-labelledby="reading-heading">
          <h2 class="lane-heading" id="reading-heading">Reading now</h2>
          <a href={`/threads/${thread.thread.id}/`} class="reading-link">
            <span class="reading-title">{thread.thread.data.title}</span>
            <span class="reading-count">{thread.posts.length} parts</span>
          </a>
          <p class="reading-blurb">{thread.thread.data.blurb}</p>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- page-wide warm tint (hero masthead handoff, v5 —
     "amber variant"). Back to a page-wide tint like v3 (v4's neutral
     bg + per-section colours is gone — see git history), but amber
     (--accent, the primary button + eyebrow label) against violet
     (--brand, the secondary button's border/text + focus ring +
     nav-star), two roles only, deliberately not reused anywhere else
     (doc §2/§9 — a third accent or either one bleeding into the
     other's job is exactly what makes it unreadable).

     Same technique as v3: re-declare the actual semantic tokens
     (--bg, --text, --text-muted, --border, --border-strong), not just
     the base ones they're derived from — a var() reference resolves
     once, at whichever rule declares it, and only :root declares
     --bg: var(--paper), so a descendant overriding --paper alone
     wouldn't change what --bg resolves to for anything already
     reading --bg. --card-border is new: the doc's section-card border
     uses its own literal value rather than the color-mix'd
     --border-strong PostCard/NewsRow already read, so it gets its own
     token instead of overloading that one with a different meaning. */
  .mh-page {
    /* How far the glow carries on below the hero, and over how much
       height it fades out (hero-overgang handoff §1b). */
    --hero-bleed: 8rem;
    --hero-fade: 26rem;
    /* The sheen sits at -30% horizontally too. `clip` rather than
       `hidden` so that overflow never becomes a scrollbar. */
    overflow-x: clip;

    /* PAGE-SPECIFIC TOKENS ONLY, AS ALIASES (light-mode handoff §2b).
       This block used to re-declare the whole palette — --paper,
       --ink, --rule, --muted, --surface and the semantic tokens on top
       of them — in a warm key, while global.css declared a cool one.
       Header, footer and every other page were cool; the homepage was
       warm; and the seam between them showed directly under the header
       and on every navigation. The palette now has exactly one source,
       and what stays here is only what is genuinely page-specific. */
    --ink-soft: color-mix(in srgb, var(--ink) 78%, var(--paper));
    --display: var(--ink);
    --accent: var(--amber);
    --accent-ink: var(--amber-ink);
    --brand: var(--violet);
    --brand-ink: var(--violet-ink);
    --card-border: color-mix(in srgb, var(--rule) 80%, var(--muted));

    /* Topography hero background (hero-topografie-en-about handoff):
       mixed from --brand/--accent/--ink rather than given their own
       hardcoded per-theme hex pair. */
    --topo: color-mix(in srgb, var(--ink) 9%, transparent);

    /* Hero effects, light (light-mode handoff §2b/§2c). The sheen was
       a brown multiplied into the panel, which on a light page reads
       as a stain rather than as light; it is now violet at normal
       blend, and the glow below it is the brand gradient's own two
       hues so the hero's only colour is the mark's colour. */
    /* Light only: dark re-declares it to `none` in its own blocks. */
    --btn-primary-shadow:
      0 1px 0 rgba(255, 255, 255, 0.4) inset,
      0 6px 16px -8px rgba(232, 162, 58, 0.55);
    --section-mark: var(--violet);

    --dot: rgba(20, 19, 26, 0.11);
    --sheen: rgba(91, 52, 214, 0.07);
    --glow-a: color-mix(in srgb, #8b5cf6 10%, transparent);
    --glow-b: color-mix(in srgb, #22d3ee 8%, transparent);

    background: var(--bg);
    color: var(--text);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .mh-page {
      --paper: #0b0a0a;
      --ink: #f4f1ef;
      --rule: #241f1b;
      --muted: #95908a;
      --surface: #131110;
      --bg: var(--paper);
      --text: var(--ink);
      --text-muted: var(--muted);
      --border: var(--rule);
      --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

      --ink-soft: #b7b0a8;
      --display: #ffffff;
      --accent: #f5b851;
      --accent-ink: #0b0a0a;
      --brand: #a98bff;
      --brand-ink: #c9b6ff;
      --card-border: #2b2724;

      --topo: color-mix(in srgb, var(--ink) 8%, transparent);
      --glow-a: color-mix(in srgb, var(--brand) 20%, transparent);
      --glow-b: color-mix(in srgb, var(--accent) 12%, transparent);

      --btn-primary-shadow: none;
      --section-mark: var(--accent);
      --dot: color-mix(in srgb, var(--ink) 14%, transparent);
      --sheen: color-mix(in srgb, var(--brand) 12%, transparent);
    }
  }
  :global(:root[data-theme="dark"]) .mh-page {
    --paper: #0b0a0a;
    --ink: #f4f1ef;
    --rule: #241f1b;
    --muted: #95908a;
    --surface: #131110;
    --bg: var(--paper);
    --text: var(--ink);
    --text-muted: var(--muted);
    --border: var(--rule);
    --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

    --ink-soft: #b7b0a8;
    --display: #ffffff;
    --accent: #f5b851;
    --accent-ink: #0b0a0a;
    --brand: #a98bff;
    --brand-ink: #c9b6ff;
    --card-border: #2b2724;

    --topo: color-mix(in srgb, var(--ink) 8%, transparent);
    --glow-a: color-mix(in srgb, var(--brand) 20%, transparent);
    --glow-b: color-mix(in srgb, var(--accent) 12%, transparent);

    --btn-primary-shadow: none;
    --section-mark: var(--accent);
    --dot: color-mix(in srgb, var(--ink) 14%, transparent);
    --sheen: color-mix(in srgb, var(--brand) 12%, transparent);
  }

  /* Two hero backgrounds live here; which one renders is decided by
     HERO_BACKGROUND in consts.ts, stamped onto the section as
     data-hero-bg. Only the matching rules apply, so switching between
     them (or back) needs no other change. isolation:isolate keeps the
     pseudo-elements' z-index:-1 scoped to this section rather than
     punching through to .mh-page; overflow:hidden clips whatever
     overmat either background asks for. */
  /* THE HERO HAS NO SURFACE OF ITS OWN (hero-overgang handoff §1).
     It used to: a tinted panel with an inset hairline along its
     bottom, and `overflow: hidden` to clip the backgrounds. That
     clipping was the visible defect. The sheen sits at `inset: -30%`
     with no mask, so it ran far below the section and was sliced off
     dead straight at the panel's edge — the horizontal line across the
     page — while its narrow diagonal band produced the angled edge at
     the left.

     Hero and page now share one background, and every effect lives on
     a single layer that fades to transparent before the clip. Nothing
     has an edge, so there is no edge to see. */
  .masthead {
    position: relative;
    isolation: isolate;
  }

  /* The glow now carries on past the hero and under this content, so
     the content has to sit above it — otherwise "Taken apart" and the
     model-update rows pick up the tint. */
  .mh-page > .container {
    position: relative;
    z-index: 1;
  }

  /* The effect layer. Clipping still happens, but on an element whose
     own mask has already faded it out by the time the clip arrives,
     and it extends past the hero so the glow carries on under the
     section cards instead of stopping at them. */
  .masthead__fx {
    position: absolute;
    inset: 0 0 calc(-1 * var(--hero-bleed)) 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - var(--hero-fade)), transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - var(--hero-fade)), transparent 100%);
  }

  /* --- "topo": warped contour lines, static (hero-topografie
     handoff). The -30% overmat is what feDisplacementMap needs — it
     pulls edges inward, so without it the warp visibly tapers off at
     the sides. */
  .masthead[data-hero-bg="topo"] .masthead__fx::before {
    content: "";
    position: absolute;
    inset: -30%;
    background: repeating-radial-gradient(
      ellipse 58% 50% at 50% 42%,
      transparent 0 24px,
      var(--topo) 24px 25px
    );
    filter: url(#seinWarp);
    -webkit-mask-image: radial-gradient(ellipse 74% 66% at 50% 38%, #000 18%, transparent 78%);
            mask-image: radial-gradient(ellipse 74% 66% at 50% 38%, #000 18%, transparent 78%);
  }

  .masthead[data-hero-bg="topo"] .masthead__fx::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 44% at 50% -6%, var(--glow-a), transparent 72%),
      radial-gradient(ellipse 42% 34% at 80% 46%, var(--glow-b), transparent 72%);
  }

  /* --- "dots": a regular dot matrix with one slow sheen crossing it
     (dotmatrix handoff A3). The sweep is a transform on its own layer
     so it runs on the compositor — deliberately no filter or
     box-shadow on it, which would throw that away and repaint the
     hero every frame.

     The glow underneath is new in light (handoff §2c): without it the
     light hero is grey dots on grey paper. Both stops are the brand
     gradient's own hues, so the one place the page shows colour is the
     same colour the logo star is. */
  .masthead[data-hero-bg="dots"] .masthead__fx {
    background:
      radial-gradient(ellipse 55% 45% at 50% -8%, var(--glow-a), transparent 70%),
      radial-gradient(ellipse 40% 32% at 82% 40%, var(--glow-b), transparent 72%);
  }

  /* LIGHT ONLY. The dots hero never had a glow; the topo variant did,
     and --glow-a/b exist for that one. Letting them through here gave
     dark a violet-and-amber wash it did not have before, and the brief
     for this change is that dark stays as it was apart from the
     transition. The topo variant keeps its own glow either way. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .masthead[data-hero-bg="dots"] .masthead__fx {
      background: none;
    }
  }
  :global(:root[data-theme="dark"]) .masthead[data-hero-bg="dots"] .masthead__fx {
    background: none;
  }

  .masthead[data-hero-bg="dots"] .masthead__fx::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 72% 62% at 50% 30%, #000 8%, transparent 74%);
            mask-image: radial-gradient(ellipse 72% 62% at 50% 30%, #000 8%, transparent 74%);
  }

  /* Wider, softer flanks than the original 42/50/58: those three stops
     made a band narrow enough that its own edges read as a hard
     diagonal line rather than as light passing over. */
  .masthead[data-hero-bg="dots"] .masthead__fx::after {
    content: "";
    position: absolute;
    inset: -30%;
    --sweep-travel: 30%;
    background: linear-gradient(112deg,
      transparent 28%,
      color-mix(in srgb, var(--sheen) 60%, transparent) 42%,
      var(--sheen) 50%,
      color-mix(in srgb, var(--sheen) 60%, transparent) 58%,
      transparent 72%);
    mix-blend-mode: var(--sweep-blend);
    animation: heroSweep 16s linear infinite;
  }

  @keyframes heroSweep {
    from { transform: translateX(calc(-1 * var(--sweep-travel))); }
    to   { transform: translateX(var(--sweep-travel)); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Still drawn, just not moving — the dots are the background, not
       the animation (dotmatrix handoff C2). */
    .masthead[data-hero-bg="dots"] .masthead__fx::after { animation: none; }
  }

  @media print {
    .masthead__fx { display: none; }
  }

  .masthead-inner {
    padding-block: 6.5rem 4.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: "Instrument Sans", var(--font-sans);
  }

  .masthead__title {
    margin: 1.875rem 0 0;
    font-family: "Archivo", var(--font-sans);
    font-weight: 700;
    font-size: clamp(3.25rem, 7.8vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--display);
  }

  .masthead__tagline {
    margin: 1.25rem 0 0;
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: var(--ink-soft);
  }

  .masthead__actions {
    margin-top: 2.125rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 46px;
    padding: 0 1.375rem;
    border-radius: 23px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The one primary action, and the only place amber appears as a
     fill. The inner highlight and the tinted drop keep the pill from
     lying flat on the paper now that there is no panel behind it
     (light-mode handoff §2c); both resolve to nothing in dark, where
     the pill already sits on a dark field. */
  .btn--primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: var(--btn-primary-shadow, none);
  }
  .btn--primary:hover { filter: brightness(1.06); }

  /* A full-strength 1px violet border reads as hard next to the amber
     pill on light paper, so the border is mixed back and the text
     carries the colour instead. */
  .btn--brand {
    border: 1px solid color-mix(in srgb, var(--brand) 45%, transparent);
    color: var(--brand-ink);
    font-weight: 500;
  }
  .btn--brand:hover { background: color-mix(in srgb, var(--brand) 8%, transparent); }

  /* Split into label/prefix/title so the mobile layout (below) can
     turn "Latest: <title>" into a two-line block with the arrow
     folded into the text flow, without duplicating the link markup. */
  .btn__label { display: none; }

  /* ---------- sections (replaces the old left-rule .lanes list) --- */
  .sections {
    width: 100%;
    margin-top: 6rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.75rem;
    text-align: left;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.125rem;
    border-top: 2px solid var(--card-border);
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  /* Violet, not amber (light-mode handoff §2c): amber is the ACTION
     accent and stays exclusive to the one primary button, so a section
     card marking itself with it was a second thing claiming to be the
     thing to click. --section-mark is amber in dark, where that
     collision does not arise and the existing look is kept. */
  .section-card--lead { border-top-color: var(--section-mark); }
  .section-card:hover { border-top-color: var(--section-mark); }
  .section-card__name { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .section-card__desc { font-size: 0.875rem; line-height: 1.45; color: var(--text-muted); }

  @media (max-width: 1100px) {
    .sections { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.5rem; }
  }

  /* mobiel-homepage-fixes #3/#4/#5 — desktop (>700px) is untouched;
     everything below only takes effect under this breakpoint. */
  @media (max-width: 700px) {
    /* Less hero to carry the glow, so less bleed and a shorter fade —
       26rem of fade under a 4rem hero bottom would start fading before
       the dots had finished. */
    .mh-page { --hero-bleed: 4rem; --hero-fade: 16rem; }
    .masthead-inner { padding-block: 3.5rem 3rem; }
    .masthead__title { margin-top: 1.5rem; }
    .masthead__tagline { max-width: 26ch; margin: 1.25rem 0 1.875rem; font-size: 1.125rem; }

    /* #3: the contour warp tuned for a desktop-width hero flings
       lines far enough at ~390px to cross each other — swap in the
       gentler #seinWarpSm filter, widen/flatten the ring ellipse and
       space the rings out so fewer of them fit across the narrower
       width, and give the mask more overmatting room since it eats
       into the edges more aggressively at this scale. */
    .masthead[data-hero-bg="topo"] .masthead__fx::before {
      inset: -45%;
      background: repeating-radial-gradient(
        ellipse 78% 44% at 50% 38%,
        transparent 0 34px,
        var(--topo) 34px 35px
      );
      filter: url(#seinWarpSm);
    }
    .masthead[data-hero-bg="topo"] .masthead__fx::after {
      background:
        radial-gradient(ellipse 80% 30% at 50% -4%, var(--glow-a), transparent 72%),
