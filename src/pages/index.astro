---
// The homepage's job is to teach the section model in about four
// seconds. It does that by contrast, not explanation: one long piece
// rendered large next to a dense column of short items says everything
// a paragraph would have said about the difference in weight.
//
// The featured slot is the newest long-form piece from ANY section
// (format `deepdive`, `paper` or `explainer`), and the dense column is
// the newest Model Updates items — the two extremes of the site.
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import NewsRow from "../components/NewsRow.astro";
import { SITE, SECTIONS } from "../consts";
import { allPosts, postUrl, postsOfFormat, postsOfKind, threadsWithPosts } from "../posts";

const [allPublished, releases, explainers, dives, papers, threads] = await Promise.all([
  allPosts(),
  postsOfKind("release"),
  postsOfKind("explainer"),
  postsOfFormat("deepdive"),
  postsOfFormat("paper"),
  threadsWithPosts(),
]);

const longForm = [...dives, ...papers].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = longForm[0];
const moreDives = longForm.slice(1, 3);
const latestReleases = releases.slice(0, 6);
const startHere = explainers.slice(0, 4);
const thread = threads.find(({ posts }) => posts.length > 1);
const latestPost = allPublished[0];
const sectionsEyebrow = SECTIONS.map((s) => s.label).join(" · ");
---
<BaseLayout>
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <!-- Homepage-only typefaces (build brief: hero masthead handoff, v5 —
       "amber variant"). Archivo loads sitewide (see BaseLayout, the
       nav wordmark uses it too); Instrument Sans and JetBrains Mono
       are only used here. -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />

  <!-- v5: like v3, the tint spans the whole homepage (doc §3/§7: no
       seam below the hero), scoped so it never reaches the nav,
       footer or any other page — see the style block. -->
  <div class="mh-page">
    <section class="masthead">
      <div class="container container--wide masthead-inner">
        <p class="masthead__eyebrow">
          <span class="masthead__rule" aria-hidden="true"></span>
          <span class="masthead__eyebrow-long">{sectionsEyebrow}</span>
          <span class="masthead__eyebrow-short">Research · Benchmarks · Security</span>
          <span class="masthead__rule" aria-hidden="true"></span>
        </p>

        <h1 class="masthead__title">{SITE.title}</h1>

        <p class="masthead__tagline">{SITE.subTagline}</p>

        <div class="masthead__actions">
          {latestPost && (
            <a class="btn btn--primary" href={postUrl(latestPost)}>
              Latest: {latestPost.data.title}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <line x1="4" y1="12" x2="19" y2="12" />
                <polyline points="13,6 19,12 13,18" />
              </svg>
            </a>
          )}
          <a class="btn btn--brand" href="/about/">About this blog</a>
        </div>

        <nav class="sections" aria-label="Browse by section">
          {SECTIONS.map((section, i) => (
            <a
              class:list={["section-card", { "section-card--lead": i === 0 }]}
              href={section.href}
            >
              <span class="section-card__name">{section.label}</span>
              <span class="section-card__desc">{section.description}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <div class="container container--wide">
      <div class="split">
        <section class="split-main" aria-labelledby="featured-heading">
          <h2 class="lane-heading" id="featured-heading">
            <a href="/research/">Taken apart</a>
          </h2>
          {featured ? (
            <PostCard post={featured} featured />
          ) : (
            <p class="empty">Nothing here yet.</p>
          )}
          {moreDives.map((post) => <PostCard post={post} compact />)}
        </section>

        <section class="split-side" aria-labelledby="scout-heading">
          <h2 class="lane-heading" id="scout-heading">
            <a href="/model-updates/">Model updates</a>
          </h2>
          <div class="side-rows">
            {latestReleases.map((post) => <NewsRow post={post} terse />)}
          </div>
          <p class="side-more"><a href="/model-updates/">All model updates</a></p>
        </section>
      </div>

      {startHere.length > 0 && (
        <section class="start" aria-labelledby="start-heading">
          <h2 class="lane-heading" id="start-heading">
            <a href="/fundamentals/">Start here</a>
          </h2>
          <div class="start-grid">
            {startHere.map((post, i) => <PostCard post={post} step={i + 1} compact />)}
          </div>
        </section>
      )}

      {thread && (
        <section class="reading" aria-labelledby="reading-heading">
          <h2 class="lane-heading" id="reading-heading">Reading now</h2>
          <a href={`/threads/${thread.thread.id}/`} class="reading-link">
            <span class="reading-title">{thread.thread.data.title}</span>
            <span class="reading-count">{thread.posts.length} parts</span>
          </a>
          <p class="reading-blurb">{thread.thread.data.blurb}</p>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- page-wide warm tint (hero masthead handoff, v5 —
     "amber variant"). Back to a page-wide tint like v3 (v4's neutral
     bg + per-section colours is gone — see git history), but amber
     (--accent, the primary button + eyebrow label) against violet
     (--brand, the secondary button's border/text + focus ring +
     nav-star), two roles only, deliberately not reused anywhere else
     (doc §2/§9 — a third accent or either one bleeding into the
     other's job is exactly what makes it unreadable).

     Same technique as v3: re-declare the actual semantic tokens
     (--bg, --text, --text-muted, --border, --border-strong), not just
     the base ones they're derived from — a var() reference resolves
     once, at whichever rule declares it, and only :root declares
     --bg: var(--paper), so a descendant overriding --paper alone
     wouldn't change what --bg resolves to for anything already
     reading --bg. --card-border is new: the doc's section-card border
     uses its own literal value rather than the color-mix'd
     --border-strong PostCard/NewsRow already read, so it gets its own
     token instead of overloading that one with a different meaning. */
  .mh-page {
    --paper: #fffdfb;
    --ink: #16130f;
    --rule: #ede8e2;
    --muted: #5e584f;
    --surface: #f7f4f0;
    --bg: var(--paper);
    --text: var(--ink);
    --text-muted: var(--muted);
    --border: var(--rule);
    --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

    --ink-soft: #4b463f;
    --label: #8a5a00;
    --display: #0c0a08;
    --accent: #e09a2b;
    --accent-ink: #1a1206;
    --brand: #6d3ff3;
    --brand-ink: #6d3ff3;
    --card-border: #ded8d1;

    background: var(--bg);
    color: var(--text);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .mh-page {
      --paper: #0b0a0a;
      --ink: #f4f1ef;
      --rule: #241f1b;
      --muted: #95908a;
      --surface: #131110;
      --bg: var(--paper);
      --text: var(--ink);
      --text-muted: var(--muted);
      --border: var(--rule);
      --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

      --ink-soft: #b7b0a8;
      --label: #e0a64e;
      --display: #ffffff;
      --accent: #f5b851;
      --accent-ink: #0b0a0a;
      --brand: #a98bff;
      --brand-ink: #c9b6ff;
      --card-border: #2b2724;
    }
  }
  :global(:root[data-theme="dark"]) .mh-page {
    --paper: #0b0a0a;
    --ink: #f4f1ef;
    --rule: #241f1b;
    --muted: #95908a;
    --surface: #131110;
    --bg: var(--paper);
    --text: var(--ink);
    --text-muted: var(--muted);
    --border: var(--rule);
    --border-strong: color-mix(in srgb, var(--rule) 70%, var(--muted));

    --ink-soft: #b7b0a8;
    --label: #e0a64e;
    --display: #ffffff;
    --accent: #f5b851;
    --accent-ink: #0b0a0a;
    --brand: #a98bff;
    --brand-ink: #c9b6ff;
    --card-border: #2b2724;
  }

  .masthead-inner {
    padding-block: 4.75rem 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: "Instrument Sans", var(--font-sans);
  }

  .masthead__eyebrow {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1.375rem;
    font-family: "JetBrains Mono", var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--label);
  }
  .masthead__rule { flex: 1 1 auto; height: 1px; background: var(--border); }
  .masthead__eyebrow-short { display: none; }

  .masthead__title {
    margin: 1.875rem 0 0;
    font-family: "Archivo", var(--font-sans);
    font-weight: 700;
    font-size: clamp(3.25rem, 7.8vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--display);
  }

  .masthead__tagline {
    margin: 1.25rem 0 0;
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: var(--ink-soft);
  }

  .masthead__actions {
    margin-top: 2.125rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 46px;
    padding: 0 1.375rem;
    border-radius: 23px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn--primary { background: var(--accent); color: var(--accent-ink); }
  .btn--primary:hover { filter: brightness(1.06); }
  .btn--brand { border: 1px solid var(--brand); color: var(--brand-ink); font-weight: 500; }
  .btn--brand:hover { background: color-mix(in srgb, var(--brand) 12%, transparent); }

  /* ---------- sections (replaces the old left-rule .lanes list) --- */
  .sections {
    width: 100%;
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.75rem;
    text-align: left;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.125rem;
    border-top: 2px solid var(--card-border);
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .section-card--lead { border-top-color: var(--accent); }
  .section-card:hover { border-top-color: var(--accent); }
  .section-card__name { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .section-card__desc { font-size: 0.875rem; line-height: 1.45; color: var(--text-muted); }

  @media (max-width: 1100px) {
    .sections { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.5rem; }
  }

  @media (max-width: 760px) {
    .masthead-inner { padding-block: 3rem 2rem; }
    .masthead__eyebrow { gap: 0.75rem; font-size: 0.625rem; letter-spacing: 0.16em; }
    .masthead__eyebrow-long { display: none; }
    .masthead__eyebrow-short { display: inline; }
    .masthead__title { margin-top: 1.5rem; }
    .masthead__tagline { max-width: 26ch; }
    .masthead__actions { margin-top: 1.75rem; width: 100%; flex-direction: column; gap: 0.75rem; }
    .btn { width: 100%; min-height: 50px; }
    .sections { margin-top: 2.5rem; display: block; }
    .section-card { gap: 0.2rem; padding: 0.8rem 0; border-top-width: 1px; }
    .section-card--lead { border-top-width: 2px; }
    .section-card__desc { font-size: 0.8rem; }
  }

  .masthead a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .section-card { transition: none; }
  }

  .lane-heading {
    padding-bottom: 0.5rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: none;
    color: var(--text-muted);
  }
  .lane-heading a { color: inherit; }

  /* The asymmetry is the point: one large thing, one dense list. */
  .split { display: grid; gap: 2.8rem; padding-top: 2.8rem; }
  @media (min-width: 900px) {
    .split { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 3.4rem; }
  }
  /* The featured hero is un-boxed (margin-bottom:0 in the component); a
     list of deep-dive cards follows it here, so give it room — otherwise
     the first card is glued to the featured's topic chips. */
  .split-main > :global(.card--featured) { margin-bottom: 2.6rem; }
  .split-side { min-width: 0; }
  .side-rows :global(.news-row:first-of-type) { border-top: none; }
  .side-more { margin-top: 1rem; font-size: 0.86rem; }

  .start { padding-top: 3.2rem; }
  .start-grid { display: grid; gap: 0 2.6rem; }
  @media (min-width: 720px) {
    .start-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .reading {
    margin-top: 3.2rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--signal);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .reading .lane-heading { border-bottom-color: color-mix(in srgb, var(--rule) 60%, transparent); }
  .reading-link { display: flex; align-items: baseline; gap: 1rem; color: var(--text); }
  .reading-title { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.015em; }
  .reading-count {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .reading-blurb {
    margin-top: 0.6rem;
    max-width: 68ch;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .empty { color: var(--text-muted); padding-block: 2rem; }
</style>
