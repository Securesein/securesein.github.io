---
import FormattedDate from "./FormattedDate.astro";
import AiAvatar from "./AiAvatar.astro";
import { CREDITS } from "../credit";
import { KINDS, TOPICS, type Credit, type Kind, type Topic } from "../taxonomy";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  topics: Topic[];
  url: string;
  credit: Credit;
  kind: Kind;
}
const { title, description, pubDate, topics, url, credit, kind } = Astro.props;
const creditInfo = CREDITS[credit];
---
<article class="post-card">
  <a href={url} class="post-card-link">
    <div class="post-card-meta">
      {credit === "scout" ? (
        <AiAvatar size={18} />
      ) : (
        <span class="post-card-avatar">{creditInfo.byline[0]}</span>
      )}
      <FormattedDate date={pubDate} />
      {kind !== "news" && <span class="post-card-badge">{KINDS[kind].label}</span>}
      {topics.slice(0, 2).map((topic) => <span class="post-card-tag">{TOPICS[topic].label}</span>)}
    </div>
    <h2 class="post-card-title">{title}</h2>
    <p class="post-card-desc">{description}</p>
  </a>
</article>

<style>
  .post-card { border-top: 1px solid var(--border); padding-block: 1.8rem; }
  .post-card-link { display: block; color: inherit; }
  .post-card-link:hover { text-decoration: none; }
  .post-card-link:hover .post-card-title {
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .post-card-meta { display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; color: var(--text-muted); flex-wrap: wrap; }
  .post-card-avatar {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px; border-radius: 999px; flex-shrink: 0;
    background: var(--bg-elevated); border: 1px solid var(--border-strong);
    font-size: 0.6rem; font-weight: 700; color: var(--text);
  }
  .post-card-tag { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; font-weight: 600; }
  .post-card-badge {
    display: inline-flex; align-items: center; padding: 0.15rem 0.55rem;
    border-radius: 999px; background: var(--gradient); color: #0a0a0c;
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .post-card-title { font-size: 1.5rem; margin-top: 0.5rem; transition: color 0.2s ease; }
  .post-card-desc { color: var(--text-muted); margin-top: 0.5rem; }
</style>
