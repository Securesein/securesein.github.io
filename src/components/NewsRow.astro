---
// The dense News row. Dense is correct for this lane: these are
// two-minute auto-drafted items and the reader is scanning, not
// browsing. No card chrome, just a rule and a grid.
import FormattedDate from "./FormattedDate.astro";
import TopicChips from "./TopicChips.astro";
import { postUrl, readingMinutes, type Post } from "../posts";
import type { Topic } from "../taxonomy";

interface Props {
  post: Post;
  /** Omit the date when the list is already grouped under a date rule. */
  showDate?: boolean;
  /** Homepage sidebar: title and date only. */
  terse?: boolean;
}
const { post, showDate = true, terse = false } = Astro.props;
const { data } = post;
---
<article
  class:list={["news-row", { "news-row--terse": terse, "news-row--nodate": !showDate }]}
  data-topics={data.topics.join(" ")}
>
  {showDate && (
    <FormattedDate date={data.pubDate} day={true} />
  )}
  <div class="news-row-body">
    <h3 class="news-row-title">
      <a href={postUrl(post)}>{data.title}</a>
    </h3>
    {!terse && (
      <Fragment>
        <p class="news-row-desc">{data.description}</p>
        <div class="news-row-meta">
          <TopicChips topics={data.topics as Topic[]} nested />
          <span class="news-row-provenance">
            <span class="news-row-scout">Scout</span>
            {data.source && <span class="news-row-publisher">{data.source.publisher}</span>}
            <span class="news-row-length">{readingMinutes(post)} min</span>
          </span>
        </div>
      </Fragment>
    )}
  </div>
</article>

<style>
  .news-row {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.2rem 1rem;
    padding: var(--news-pad);
    /* Light: a raised card spaced by margin; dark: a flat row with a top
       divider — the whole flip lives in the theme tokens. */
    border-top: var(--row-divider);
    /* The News marker: a soft 2px left rule, never the accent. On a card
       it's a gentle left edge; in dark it's the lane marker as before. */
    border-left: 2px solid var(--border-strong);
    background: var(--card-bg);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    margin-bottom: var(--card-gap);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .news-row:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(var(--card-lift, 0));
  }
  @media (prefers-reduced-motion: reduce) {
    .news-row { transition: none; }
    .news-row:hover { transform: none; }
  }
  .news-row > time {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-top: 0.2rem;
  }
  .news-row-body { display: grid; gap: 0.4rem; min-width: 0; }
  .news-row-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .news-row-title a { color: var(--text); }
  .news-row-title a:hover { color: var(--signal); text-decoration: none; }
  .news-row-title a::after { content: ""; position: absolute; inset: 0; }
  .news-row-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 62ch;
  }
  .news-row-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.15rem;
  }
  .news-row-provenance {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .news-row-scout { font-weight: 600; }

  /* The homepage sidebar list stays a compact flat list, not cards —
       reset the card treatment and keep a simple divider. */
  .news-row--terse {
    grid-template-columns: 3.6rem 1fr;
    padding: 0.62rem 0;
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    border-left: none;
    margin-bottom: 0;
    /* Its own hairline, independent of the card model, so the compact
       list stays separated in both themes. First row's is removed by the
       homepage (.side-rows). */
    border-top: 1px solid var(--rule);
  }
  .news-row--terse:hover { box-shadow: none; transform: none; }
  .news-row--terse .news-row-title { font-size: 0.95rem; font-weight: 500; }

  /* No date column (the list is grouped under a date rule): the body is
     the only child, so collapse to one column — otherwise it lands in
     the empty fixed date track and gets squeezed to ~4.5rem wide. */
  .news-row--nodate { grid-template-columns: 1fr; }

  @media (max-width: 560px) {
    .news-row,
    .news-row--terse { grid-template-columns: 1fr; }
    .news-row > time { padding-top: 0; }
    .news-row-provenance { margin-left: 0; width: 100%; }
  }
</style>
