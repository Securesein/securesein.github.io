---
// Topic chips are links, always. They are the mechanism by which a
// post appears in more than one place — a news item tagged `safety`
// is reachable from /news/, from /topics/safety/, and from search —
// and on the old site they were switched off, rendered as inert spans.
import { TOPICS, type Topic } from "../taxonomy";

interface Props {
  topics: Topic[];
  /** Rendered inside a card whose whole surface is already a link. */
  nested?: boolean;
}
const { topics, nested = false } = Astro.props;
---
<ul class:list={["topic-chips", { "topic-chips--nested": nested }]}>
  {topics.map((topic) => (
    <li>
      <a class="topic-chip" href={`/topics/${topic}/`}>{TOPICS[topic].label}</a>
    </li>
  ))}
</ul>

<style>
  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* A card is one big anchor; the chips sit above it in the stacking
     order so they keep their own hit areas instead of being swallowed
     by the card link that covers them. */
  .topic-chips--nested { position: relative; z-index: 1; }
  .topic-chip {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    /* A faint wash in the brand's own violet→cyan family — the same
       gradient as the logo and the kind pill, at a whisper, so the
       chips belong to one palette rather than colour-coding each topic. */
    background: linear-gradient(
      105deg,
      color-mix(in srgb, var(--brand-from) 8%, var(--surface)),
      color-mix(in srgb, var(--brand-to) 8%, var(--surface))
    );
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .topic-chip:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--border) 45%, var(--brand-from));
    background: linear-gradient(
      105deg,
      color-mix(in srgb, var(--brand-from) 16%, var(--surface)),
      color-mix(in srgb, var(--brand-to) 16%, var(--surface))
    );
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .topic-chip { transition: none; }
  }
</style>
