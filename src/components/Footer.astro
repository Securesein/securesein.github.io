---
import { SITE, SECTIONS } from "../consts";
const year = new Date().getFullYear();

// Per-lane feeds, because the lanes have wildly different volumes —
// four deep dives a month should not arrive with forty Scout items.
const feeds = [
  { label: "Everything", href: "/rss.xml" },
  ...SECTIONS.map((s) => ({ label: s.label, href: `${s.href}/rss.xml` })),
];
---
<footer class="site-footer">
  <div class="container container--wide">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-name" aria-label="Go to homepage">
          <svg class="footer-mark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z" fill="url(#footerGradient)"/>
            <defs>
              <linearGradient id="footerGradient" x1="0" y1="0" x2="24" y2="24">
                <stop offset="0" stop-color="#8b5cf6"/>
                <stop offset="1" stop-color="#22d3ee"/>
              </linearGradient>
            </defs>
          </svg>
          <span>{SITE.title}</span>
        </a>
        <p class="footer-tagline">{SITE.tagline}</p>
        <p class="footer-sub">{SITE.subTagline}</p>
      </div>

      <div class="footer-cols">
        <nav class="footer-col" aria-label="Sections">
          <h2>Read</h2>
          <ul>
            {SECTIONS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            <li><a href="/topics/">Topics</a></li>
            <li><a href="/threads/">Threads</a></li>
          </ul>
        </nav>

        <nav class="footer-col" aria-label="Feeds">
          <h2>Feeds</h2>
          <ul>
            {feeds.map((f) => <li><a href={f.href}>{f.label}</a></li>)}
          </ul>
        </nav>

        <nav class="footer-col" aria-label="This site">
          <h2>This site</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/colophon/">Colophon</a></li>
            <li><a href="/search/">Search</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <p class="footer-note">
      &copy; {year} {SITE.title}. Curated by a human, drafted in part by an AI —
      <a href="/colophon/">which part, and by which model</a>.
    </p>
  </div>
</footer>

<style>
  /* The site's closing band: a filled panel set off from the page, with
     the wordmark restated so the page ends on the identity rather than
     trailing off into links. A plain hairline on top — the band and the
     brand block carry the distinction, no loud rule needed. */
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    padding-block: 3.2rem 2.8rem;
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.6rem 3rem;
  }

  .footer-brand { max-width: 24rem; }
  .footer-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .footer-name:hover { text-decoration: none; }
  .footer-mark { width: 22px; height: 22px; flex-shrink: 0; }
  .footer-tagline {
    margin-top: 0.75rem;
    color: var(--text);
    font-size: 0.98rem;
  }
  .footer-sub {
    margin-top: 0.3rem;
    color: var(--text-muted);
    font-size: 0.86rem;
  }

  .footer-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
  }
  .footer-col h2 {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 0.7rem;
  }
  .footer-col ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .footer-col a { color: var(--text); font-size: 0.9rem; }
  .footer-col a:hover { color: var(--link); }

  .footer-note {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .footer-top { flex-direction: column; gap: 2rem; }
  }
</style>
