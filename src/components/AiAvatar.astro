---
// Scout's avatar: a small friendly bot face, drawn to sit inside the same
// 44px round `.avatar` slot the initials avatar uses for human authors.
interface Props {
  size?: number;
}
const { size = 44 } = Astro.props;
---
<span class="ai-avatar" style={`--size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width="58%" height="58%" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <line x1="12" y1="2.4" x2="12" y2="5" />
    <circle cx="12" cy="2" r="0.9" fill="currentColor" stroke="none" />
    <rect x="5" y="6" width="14" height="12" rx="4" />
    <circle cx="9" cy="12" r="1.2" fill="currentColor" stroke="none" />
    <circle cx="15" cy="12" r="1.2" fill="currentColor" stroke="none" />
    <rect x="9" y="15" width="6" height="1.4" rx="0.7" fill="currentColor" stroke="none" />
  </svg>
</span>

<style>
  .ai-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    border-radius: 999px;
    background: var(--gradient);
    color: #0a0a0c;
    flex-shrink: 0;
  }
</style>
