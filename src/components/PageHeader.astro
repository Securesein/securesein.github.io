---
// Shared H1 + standfirst for the section and shelf landing pages, so
// every index opens the same way. The eyebrow (design handoff §4.1/
// §4.2) is optional: pages that pass one get the mono label + hairline
// + date device that now opens the section pages; the rest (About,
// Colophon, Search) keep a plain heading rather than inventing a label
// and a date that would mean nothing there.
import Eyebrow from "./Eyebrow.astro";

interface Props {
  title: string;
  /** One or two sentences of human framing, in the author's voice. */
  standfirst?: string;
  /** Small, calm, never a banner — e.g. the standing Scout note. */
  note?: string;
  /** Mono label (left) + optional date (right) above the title. */
  eyebrow?: { label: string; meta?: string };
}
const { title, standfirst, note, eyebrow } = Astro.props;
---
<header class="page-header">
  {eyebrow && <Eyebrow label={eyebrow.label} meta={eyebrow.meta} />}
  <h1 class:list={{ "page-header__title--display": !!eyebrow }}>{title}</h1>
  {standfirst && <p class="page-standfirst">{standfirst}</p>}
  <slot />
  {note && <p class="page-note">{note}</p>}
</header>

<style>
  .page-header { padding-top: 3rem; margin-bottom: 1.6rem; }
  .page-header h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    letter-spacing: -0.025em;
  }
  /* Only pages that opted into the eyebrow also get the bigger Archivo
     title (hierarchy step 2 of 104/68/56/27, design handoff §1) — a
     plain page-header title elsewhere stays as it already was. */
  .page-header__title--display {
    margin-top: 1.75rem;
    font-family: "Archivo", var(--font-sans);
    font-weight: 700;
    font-size: clamp(2.5rem, 5.2vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .page-standfirst {
    margin-top: 0.9rem;
    max-width: 46ch;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .page-note {
    margin-top: 1.4rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--rule);
    max-width: 58ch;
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }
</style>
