---
// The three lanes are flat nav items now, not a "Sections" dropdown.
// The old nav hid them one click deep and mixed them with the subject
// pills; the whole point of the IA is that a reader can see the three
// reading modes at a glance and pick one.
import { SITE, SECTIONS, NAV_LINKS } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;
const links = [...SECTIONS, ...NAV_LINKS];
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="container container--wide header-inner">
    <a href="/" class="brand" aria-label="Go to homepage">
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z" fill="url(#brandGradient)"/>
        <defs>
          <linearGradient id="brandGradient" x1="0" y1="0" x2="24" y2="24">
            <stop offset="0" stop-color="#8b5cf6"/>
            <stop offset="1" stop-color="#22d3ee"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="brand-name">{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["nav-link", { "nav-link--on": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <!-- Below 900px the seven flat links don't fit (mobiel-homepage-
         fixes #1): .nav hides and this <details> panel takes over.
         No JS needed — the site has no client router, so a full page
         navigation from a link inside always closes the panel for
         free. -->
    <details class="nav-menu">
      <summary class="nav-menu__toggle" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </summary>
      <nav class="nav-menu__sheet" aria-label="Main navigation">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={["nav-menu__link", { "nav-menu__link--on": isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </details>
    <div class="header-actions">
      <a href="/search/" class="icon-link" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8" />
          <path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .header-inner { display: flex; align-items: center; gap: 1.5rem; height: 64px; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  /* Hero masthead handoff, v2: the wordmark now matches the homepage
     title's display face everywhere it appears, not just there. */
  .brand-name { font-family: "Archivo", var(--font-sans); }
  .brand:hover { text-decoration: none; }
  /* The brand star — the one place the violet→cyan identity gradient
     lives in the chrome. Small and quiet, but it signs the page. */
  .brand-mark {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .nav {
    display: flex;
    gap: 1.25rem;
    margin-right: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav::-webkit-scrollbar { display: none; }
  .nav-link {
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--text); text-decoration: none; }
  .nav-link--on { color: var(--text); }

  .nav-menu { display: none; }

  .header-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
  }
  .icon-link:hover { color: var(--text); border-color: var(--text-muted); text-decoration: none; }
  .icon-link svg { width: 18px; height: 18px; }

  @media (max-width: 560px) { .brand-name { display: none; } }

  /* Nav collapse (mobiel-homepage-fixes #1). Logo, search and the
     theme toggle stay put; the seven flat links move into a fixed
     sheet under the header. */
  @media (max-width: 900px) {
    .nav { display: none; }
    .nav-menu { display: block; margin-right: auto; }
    .nav-menu__toggle {
      list-style: none;
      cursor: pointer;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      border: 1px solid var(--border-strong);
      color: var(--text-muted);
      display: grid;
      place-items: center;
    }
    .nav-menu__toggle::-webkit-details-marker { display: none; }
    .nav-menu__toggle svg { width: 20px; height: 20px; }
    .nav-menu[open] .nav-menu__toggle { color: var(--text); border-color: var(--text-muted); }

    .nav-menu__sheet {
      position: fixed;
      inset: 64px 0 auto 0;
      z-index: 49;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      padding: 0.75rem 1.5rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
      display: grid;
      gap: 2px;
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
    }
    .nav-menu__link {
      padding: 0.875rem 0;
      font-size: 1.0625rem;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--rule);
    }
    .nav-menu__link:last-child { border-bottom: 0; }
    .nav-menu__link--on { color: var(--link); }
  }

  @media (max-width: 420px) {
    .header-inner { gap: 0.7rem; }
    .nav { gap: 0.8rem; }
    .nav-link { font-size: 0.84rem; }
  }
</style>
