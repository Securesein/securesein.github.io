---
import { SITE } from "../consts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Switches the body to the long-form reading typeface (§6). */
  reading?: boolean;
  /** Absolute or site-relative share image; falls back to the default. */
  image?: string;
  /** Alt text for `image`, so a shared card is described, not just seen. */
  imageAlt?: string;
  /** "article" on post pages, so the OG type is honest. */
  ogType?: "website" | "article";
  /** Keep a page out of search results — for pages that exist for a
   * person mid-visit rather than for someone arriving from a search
   * (the search page itself, the 404). */
  noindex?: boolean;
}
const {
  title,
  description,
  reading = false,
  image,
  imageAlt,
  ogType = "website",
  noindex = false,
} = Astro.props;
// The homepage passes no title, and falling back to the bare brand
// name wasted the most valuable title tag on the site — see
// SITE.homeTitle's own comment.
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.homeTitle;
const pageDesc = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Per-post OG images are the post's own hero where it has one, and a
// single site card otherwise. Rendering a bespoke card per post would
// mean a whole image pipeline for a handful of posts a week.
const ogImage = new URL(image ?? "/og-default.png", Astro.site);
const ogImageAlt = imageAlt ?? `${SITE.title} — ${SITE.subTagline}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — everything`}
      href="/rss.xml"
    />
    <!-- Per-page extras: per-lane RSS, JSON-LD, OG overrides. -->
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Four families: Inter for UI, metadata and the News rows;
         Source Serif for long-form body text; Archivo for the nav
         wordmark and every page-head/masthead title (hero masthead
         handoff); JetBrains Mono for the eyebrow line that now opens
         every page (design handoff §2/§4.1) — all loaded sitewide
         since the nav and the Eyebrow component render everywhere. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Archivo:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Only stamps data-theme when the reader has made an explicit
      // choice. Left alone, the CSS follows prefers-color-scheme on its
      // own, so the page is correct before any script runs.
      (function () {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={{ reading }}>
    <!-- Shared "topography" hero background (hero-topografie handoff):
         one feTurbulence/feDisplacementMap filter, referenced by both
         the homepage and About's hero via `filter: url(#seinWarp)`.
         Lives once in the layout specifically so two pages never end
         up with two elements sharing the id — SVG filter ids are
         globally scoped to the document, and a duplicate would make
         which one actually applies unpredictable. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="seinWarp">
        <feTurbulence type="fractalNoise" baseFrequency="0.0035" numOctaves="4" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="150" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
